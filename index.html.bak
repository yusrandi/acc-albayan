<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AL BAYAN HIDAYATULLAH MAKASSAR — Laporan Keuangan Profesional</title>
<style>
:root{--bg:#f4f7fb;--card:#fff;--text:#182230;--muted:#667085;--line:#e4e9f0;--primary:#1769e0;--primary2:#0d47a1;--good:#087443;--bad:#b42318;--warn:#b54708;--shadow:0 10px 30px rgba(16,24,40,.07)}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}
button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}.app{display:flex;min-height:100vh}
.sidebar{width:255px;background:#101828;color:#fff;padding:20px 14px;position:fixed;inset:0 auto 0 0;overflow:auto}
.brand{font-weight:800;font-size:20px;padding:8px 10px 22px}.brand span{color:#5ea7ff}.nav button{width:100%;text-align:left;background:transparent;color:#d0d5dd;padding:12px 13px;border-radius:9px;margin:2px 0}.nav button:hover,.nav button.active{background:#1d2939;color:#fff}.nav small{display:block;color:#667085;padding:16px 13px 6px;text-transform:uppercase;letter-spacing:.08em}
.main{margin-left:255px;width:calc(100% - 255px);padding:24px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.top h1{margin:0;font-size:25px}.actions{display:flex;gap:8px}.btn{padding:10px 14px;border-radius:8px;background:#fff;border:1px solid var(--line);color:var(--text)}.btn.primary{background:var(--primary);color:#fff;border-color:var(--primary)}.btn.danger{background:#fff1f0;color:var(--bad);border-color:#ffd5d2}.btn.good{background:#ecfdf3;color:var(--good);border-color:#abefc6}
.page{display:none}.page.active{display:block}.grid{display:grid;gap:14px}.g4{grid-template-columns:repeat(4,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:13px;padding:18px;box-shadow:var(--shadow)}.metric .label{font-size:13px;color:var(--muted)}.metric .value{font-size:25px;font-weight:800;margin:8px 0}.metric .sub{font-size:12px;color:var(--muted)}
.section{margin-top:18px}.section h3{margin:0 0 12px}.tablewrap{overflow:auto}.table{width:100%;border-collapse:collapse;font-size:13px}.table th,.table td{padding:10px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}.table th{background:#f8fafc;color:#475467}.num{text-align:right!important}.pill{display:inline-block;padding:4px 8px;border-radius:999px;font-size:11px;font-weight:700}.pill.good{background:#ecfdf3;color:var(--good)}.pill.warn{background:#fffaeb;color:var(--warn)}.pill.bad{background:#fef3f2;color:var(--bad)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.toolbar input,.toolbar select,.form input,.form select,.form textarea{padding:10px;border:1px solid #d0d5dd;border-radius:8px;background:#fff;width:100%}.form label{display:block;font-size:12px;font-weight:700;color:#475467;margin-bottom:5px}.form .field{margin-bottom:10px}
.modal{position:fixed;inset:0;background:rgba(16,24,40,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:20}.modal.open{display:flex}.modalbox{background:#fff;border-radius:14px;max-width:900px;width:100%;max-height:90vh;overflow:auto;padding:20px}.modalhead{display:flex;justify-content:space-between;align-items:center}.modalhead h3{margin:0}.x{background:#f2f4f7;border-radius:50%;width:32px;height:32px}
.jrow{display:grid;grid-template-columns:130px 1fr 150px 150px 42px;gap:8px;margin-bottom:8px}.journal-total{display:flex;justify-content:flex-end;gap:30px;font-weight:800;padding-top:10px}
canvas{max-width:100%}.notice{padding:11px 13px;border-radius:9px;background:#eff8ff;color:#175cd3;font-size:12px}.empty{padding:30px;text-align:center;color:var(--muted)}
@media(max-width:1000px){.sidebar{width:210px}.main{margin-left:210px;width:calc(100% - 210px)}.g4{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:1fr}.jrow{grid-template-columns:1fr 1fr}.jrow>*:nth-child(3),.jrow>*:nth-child(4){grid-column:span 1}}
@media(max-width:700px){.sidebar{position:static;width:100%;height:auto}.app{display:block}.main{margin:0;width:100%;padding:14px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap}.nav small{display:none}.g4,.g2{grid-template-columns:1fr}.top{align-items:flex-start;gap:10px;flex-direction:column}}

.login-screen{position:fixed;inset:0;background:linear-gradient(135deg,#07111f,#123b6d);display:flex;align-items:center;justify-content:center;z-index:100;padding:20px}
.login-box{width:min(430px,100%);background:#fff;border-radius:18px;padding:30px;box-shadow:0 25px 70px rgba(0,0,0,.25)}
.login-brand{font-size:25px;font-weight:900;margin-bottom:6px}.login-brand span{color:#1769e0}.login-sub{color:#667085;font-size:13px;margin-bottom:22px}
.userbar{display:flex;align-items:center;gap:10px}.userchip{font-size:12px;color:#475467;background:#f2f4f7;padding:8px 10px;border-radius:20px}
.activity{display:grid;gap:9px}.activity-row{display:flex;align-items:center;gap:10px;font-size:12px}.activity-label{width:120px}.activity-track{flex:1;height:9px;background:#eaecf0;border-radius:20px;overflow:hidden}.activity-fill{height:100%;border-radius:20px;background:#1769e0}

.dashboard-hero{background:linear-gradient(135deg,#0b1f3a,#1769e0);color:#fff;border-radius:18px;padding:22px;margin-bottom:16px;box-shadow:0 14px 35px rgba(23,105,224,.18)}
.dashboard-hero h2{margin:0 0 5px;font-size:23px}.dashboard-hero p{margin:0;color:#dbeafe;font-size:12px}
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px}.kpi{background:#fff;border:1px solid var(--line);border-radius:14px;padding:17px;box-shadow:var(--shadow);position:relative;overflow:hidden}.kpi .icon{position:absolute;right:15px;top:14px;font-size:25px;opacity:.15}.kpi .label{font-size:12px;color:#667085}.kpi .value{font-size:22px;font-weight:900;margin-top:7px}.kpi .trend{font-size:11px;margin-top:6px;color:#667085}
.dashboard-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:14px}.dashboard-grid .card{min-height:290px}
.chart-box{height:235px;display:flex;align-items:center;justify-content:center}.donut{width:190px;height:190px;border-radius:50%;position:relative;background:conic-gradient(#1769e0 var(--p1),#12b76a 0 var(--p2),#f79009 0 var(--p3),#98a2b3 0)}.donut:after{content:"";position:absolute;inset:38px;background:#fff;border-radius:50%}.donut-center{position:absolute;z-index:2;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;font-weight:900}.donut-center small{font-weight:500;color:#667085}
.legend{display:grid;gap:8px}.legend-row{display:flex;align-items:center;justify-content:space-between;font-size:12px}.dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:7px}
@media(max-width:1000px){.kpi-grid{grid-template-columns:repeat(2,1fr)}.dashboard-grid{grid-template-columns:1fr}}
@media(max-width:600px){.kpi-grid{grid-template-columns:1fr}}
</style>

<style>
.account-integrity-note{font-size:12px;padding:10px 12px;border:1px solid #dbe4ef;border-radius:10px;background:#f8fafc;margin:8px 0}
.badge-header{font-size:10px;padding:3px 7px;border-radius:999px;background:#eef2f7;color:#475569}
</style>


<style id="dashboard-elegant">
.dash-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;padding:24px 26px;margin-bottom:18px;border:1px solid #e4eaf2;border-radius:20px;background:linear-gradient(135deg,#ffffff 0%,#f7faff 100%);box-shadow:0 10px 30px rgba(16,24,40,.05)}
.dash-kicker{font-size:11px;font-weight:800;letter-spacing:.12em;color:#175cd3;margin-bottom:6px}.dash-head h2{margin:0;font-size:27px;letter-spacing:-.03em;color:#101828}.dash-head p{margin:7px 0 0;color:#667085;font-size:13px}.dash-period{min-width:145px;text-align:right;padding:10px 14px;border-radius:13px;background:#fff;border:1px solid #e4eaf2}.dash-period span{display:block;font-size:9px;font-weight:800;color:#98a2b3;letter-spacing:.1em}.dash-period b{font-size:14px;color:#344054}
.dash-kpis{grid-template-columns:repeat(6,minmax(0,1fr));gap:13px}.kpi{border:1px solid #e5eaf1!important;border-radius:17px!important;box-shadow:0 8px 24px rgba(16,24,40,.045)!important;padding:17px!important;background:#fff!important}.kpi-primary{background:linear-gradient(145deg,#f5f9ff,#fff)!important;border-color:#d7e4ff!important}.kpi-top{display:flex;justify-content:space-between;align-items:center}.kpi .icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:#f2f4f7;font-size:17px}.kpi-primary .icon{background:#eaf2ff}.kpi-tag{font-size:8px;font-weight:800;letter-spacing:.08em;color:#98a2b3}.kpi .label{margin-top:13px;font-size:11px;font-weight:700;color:#667085}.kpi .value{font-size:21px!important;line-height:1.2;margin-top:5px;font-weight:800!important;letter-spacing:-.02em;color:#101828}.kpi .value.small{font-size:18px!important}.kpi .trend{margin-top:7px;font-size:10px;color:#98a2b3}
.dash-main{grid-template-columns:1.35fr .85fr;gap:16px}.card{border-radius:17px!important;border:1px solid #e5eaf1!important;box-shadow:0 8px 24px rgba(16,24,40,.04)!important}.card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:10px}.card-head h3{margin:0;font-size:14px;color:#101828}.card-head p{margin:4px 0 0;font-size:10px;color:#98a2b3}.mini-badge{font-size:8px;font-weight:800;color:#067647;background:#ecfdf3;border:1px solid #abefc6;border-radius:999px;padding:5px 8px}.chart-box.tall{height:270px}
.finance-mix{padding-top:12px}.mix-item{margin:18px 0}.mix-item>div:first-child{display:flex;justify-content:space-between;font-size:11px;color:#667085}.mix-item b{color:#101828}.mix-track{height:10px;background:#f2f4f7;border-radius:99px;overflow:hidden;margin-top:8px}.mix-fill{height:100%;border-radius:99px}.mix-fill.receive{background:#2563eb}.mix-fill.expense{background:#f59e0b}.mix-result{display:flex;justify-content:space-between;margin-top:25px;padding-top:15px;border-top:1px dashed #d0d5dd;font-size:12px;color:#667085}.mix-result strong{color:#101828}
.summary-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f0f2f5;font-size:11px;color:#667085}.summary-row:last-child{border-bottom:0}.summary-row b{color:#101828}.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px}.status-dot.good{background:#12b76a}.status-dot.warn{background:#f79009}.status-dot.bad{background:#f04438}.activity-note{font-size:10px;color:#98a2b3;margin-top:12px}.dash-lower .card{min-height:175px}
@media(max-width:1200px){.dash-kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.dash-head{align-items:flex-start;flex-direction:column}.dash-period{text-align:left}.dash-kpis,.dash-main{grid-template-columns:1fr}.kpi .value{font-size:19px!important}}
</style>


<style id="ranking-dashboard">
.ranking-grid{grid-template-columns:1fr 1fr;gap:16px}
.ranking-card{min-height:330px}
.rank-row{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #f0f2f5}
.rank-row:last-child{border-bottom:0}.rank-num{width:25px;height:25px;border-radius:8px;display:grid;place-items:center;background:#f2f4f7;color:#475467;font-size:10px;font-weight:800}
.rank-main{min-width:0}.rank-name{font-size:11px;font-weight:700;color:#344054;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rank-code{font-size:9px;color:#98a2b3;margin-top:2px}.rank-track{height:6px;background:#f2f4f7;border-radius:99px;margin-top:7px;overflow:hidden}.rank-fill{height:100%;border-radius:99px}.rank-fill.income,.bar-rank-fill.income{background:#2563eb}.rank-fill.expense,.bar-rank-fill.expense{background:#f59e0b}.rank-value{text-align:right}.rank-value b{display:block;font-size:10px;color:#101828}.rank-value span{font-size:9px;color:#98a2b3}.empty-ranking{padding:40px 10px;text-align:center;color:#98a2b3;font-size:11px}.ranking-chart-card{margin-top:16px}.bar-rank{margin:11px 0}.bar-rank-head{display:flex;justify-content:space-between;gap:15px;font-size:10px;color:#667085}.bar-rank-head span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bar-rank-head b{white-space:nowrap;color:#344054}.bar-rank-track{height:10px;background:#f2f4f7;border-radius:99px;overflow:hidden;margin-top:6px}.bar-rank-fill{height:100%;border-radius:99px}
@media(max-width:800px){.ranking-grid{grid-template-columns:1fr}}
</style>


<style id="cashflow-visuals">
.cashflow-visuals{margin-top:16px}.cf-row{margin:18px 0}.cf-head{display:flex;justify-content:space-between;gap:12px;font-size:11px;color:#667085}.cf-head b{color:#101828}.cf-track{height:11px;background:#f2f4f7;border-radius:99px;overflow:hidden;margin-top:8px}.cf-fill{height:100%;border-radius:99px}.cf-fill.in{background:#2563eb}.cf-fill.out{background:#f59e0b}.cf-net{display:flex;justify-content:space-between;border-top:1px dashed #d0d5dd;padding-top:14px;margin-top:20px;font-size:12px;color:#667085}.cf-net strong{color:#101828}.cash-percent-chart{display:flex;align-items:center;justify-content:center;gap:26px;min-height:190px}.cf-donut{width:145px;height:145px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#2563eb 0 var(--in),#f59e0b var(--in) calc(var(--in) + var(--out)),#e4e7ec calc(var(--in) + var(--out)) 100%);position:relative}.cf-donut:after{content:"";position:absolute;width:94px;height:94px;border-radius:50%;background:#fff}.cf-donut>div{position:relative;z-index:1;text-align:center}.cf-donut b{display:block;font-size:20px;color:#101828}.cf-donut span{font-size:9px;color:#98a2b3}.cf-legend{min-width:130px}.cf-legend div{display:grid;grid-template-columns:10px 1fr auto;gap:7px;align-items:center;margin:12px 0;font-size:10px;color:#667085}.cf-legend i{width:8px;height:8px;border-radius:50%;display:block}.cf-legend i.in{background:#2563eb}.cf-legend i.out{background:#f59e0b}.cf-legend b{color:#101828}@media(max-width:700px){.cash-percent-chart{flex-direction:column}}
</style>


<style id="equity-visuals">
.equity-visuals{margin-top:16px}.eq-row{padding:11px 0;border-bottom:1px solid #f0f2f5}.eq-row:last-child{border-bottom:0}.eq-head{display:flex;justify-content:space-between;gap:15px;font-size:10px;color:#667085}.eq-head b:last-child{color:#101828}.eq-code{font-size:9px;color:#98a2b3;margin-top:3px}.eq-track{height:9px;background:#f2f4f7;border-radius:99px;overflow:hidden;margin-top:7px}.eq-fill{height:100%;border-radius:99px;background:#16a34a}.equity-percent-chart{min-height:210px;display:flex;align-items:center;justify-content:center;gap:28px}.eq-donut{width:150px;height:150px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#16a34a,#2563eb,#7c3aed,#f59e0b,#06b6d4,#16a34a);position:relative}.eq-donut:after{content:"";position:absolute;width:96px;height:96px;background:#fff;border-radius:50%}.eq-donut>div{position:relative;z-index:1;text-align:center}.eq-donut b{display:block;font-size:22px;color:#101828}.eq-donut span{font-size:9px;color:#98a2b3}.eq-legend{max-height:190px;overflow:auto;min-width:150px}.eq-legend div{display:grid;grid-template-columns:8px 1fr auto;gap:7px;align-items:center;margin:9px 0;font-size:9px;color:#667085}.eq-legend i{width:7px;height:7px;border-radius:50%;background:#16a34a}.eq-legend b{color:#101828}@media(max-width:700px){.equity-percent-chart{flex-direction:column}}
</style>


<style id="premium-dashboard-theme">
:root{
  --ab-navy:#102a43;
  --ab-blue:#1769aa;
  --ab-sky:#3b82c4;
  --ab-teal:#148f8a;
  --ab-green:#2e9d68;
  --ab-gold:#c99a3b;
  --ab-ink:#172b4d;
  --ab-muted:#6b7c93;
  --ab-line:#e4eaf1;
  --ab-soft:#f5f8fb;
  --ab-white:#ffffff;
}
body{background:linear-gradient(180deg,#f5f8fb 0%,#eef3f8 100%)!important;color:var(--ab-ink)}
.sidebar{background:linear-gradient(180deg,#102a43 0%,#173f5f 55%,#0e334e 100%)!important;box-shadow:8px 0 28px rgba(16,42,67,.13)}
.sidebar .brand,.sidebar h1,.sidebar .logo{color:#fff!important}
.sidebar a,.sidebar button{border-radius:11px!important;color:#dbe8f4!important;transition:.2s ease}
.sidebar a:hover,.sidebar button:hover{background:rgba(255,255,255,.10)!important;color:#fff!important}
.sidebar a.active{background:linear-gradient(90deg,rgba(59,130,196,.28),rgba(20,143,138,.16))!important;color:#fff!important;border-left:3px solid #c99a3b!important}
.topbar{background:rgba(255,255,255,.92)!important;border-bottom:1px solid var(--ab-line)!important;backdrop-filter:blur(12px);box-shadow:0 4px 18px rgba(16,42,67,.04)}
.dash-head{background:linear-gradient(135deg,#102a43 0%,#1769aa 58%,#148f8a 100%)!important;border:0!important;color:#fff;box-shadow:0 16px 38px rgba(16,42,67,.18)!important;position:relative;overflow:hidden}
.dash-head:after{content:"";position:absolute;width:240px;height:240px;right:-70px;top:-120px;border-radius:50%;background:rgba(255,255,255,.09)}
.dash-kicker{color:#d6e7f5!important}.dash-head h2,.dash-head p{color:#fff!important}.dash-head p{opacity:.78}
.dash-period{background:rgba(255,255,255,.12)!important;border:1px solid rgba(255,255,255,.22)!important;color:#fff;backdrop-filter:blur(8px);position:relative;z-index:2}.dash-period span{color:#cfe0ef!important}.dash-period b{color:#fff!important}
.kpi{background:rgba(255,255,255,.98)!important;border:1px solid #e5ebf2!important;box-shadow:0 10px 30px rgba(16,42,67,.07)!important;transition:transform .2s ease,box-shadow .2s ease;border-radius:18px!important}
.kpi:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(16,42,67,.11)!important}
.kpi-primary{background:linear-gradient(145deg,#edf6ff,#fff)!important;border-color:#cfe2f5!important}
.kpi .icon{background:#f1f5f9!important;color:var(--ab-blue)}.kpi-primary .icon{background:#dceeff!important}
.kpi-tag{color:#8a9bad!important}.kpi .label{color:#68798d!important}.kpi .value{color:#102a43!important}.kpi .trend{color:#8292a5!important}
.card{background:rgba(255,255,255,.97)!important;border:1px solid var(--ab-line)!important;box-shadow:0 9px 28px rgba(16,42,67,.055)!important}
.card-head h3{color:#183b56!important}.card-head p{color:#8191a5!important}
.mini-badge{color:#1769aa!important;background:#edf6ff!important;border-color:#cfe2f5!important}
.finance-mix .mix-fill.receive{background:linear-gradient(90deg,#1769aa,#3b82c4)!important}
.finance-mix .mix-fill.expense{background:linear-gradient(90deg,#c99a3b,#e0b75c)!important}
.rank-fill.income,.bar-rank-fill.income{background:linear-gradient(90deg,#1769aa,#3b82c4)!important}
.rank-fill.expense,.bar-rank-fill.expense{background:linear-gradient(90deg,#c99a3b,#e0b75c)!important}
.eq-fill{background:linear-gradient(90deg,#148f8a,#2e9d68)!important}
.cf-fill.in{background:linear-gradient(90deg,#1769aa,#148f8a)!important}.cf-fill.out{background:linear-gradient(90deg,#c99a3b,#d9a441)!important}
.eq-donut{background:conic-gradient(#148f8a,#1769aa,#c99a3b,#2e9d68,#3b82c4,#148f8a)!important}
.cf-donut{background:conic-gradient(#1769aa 0 var(--in),#c99a3b var(--in) calc(var(--in) + var(--out)),#dce3ea calc(var(--in) + var(--out)) 100%)!important}
.status-dot.good{background:#2e9d68!important}.status-dot.warn{background:#c99a3b!important}.status-dot.bad{background:#c84c4c!important}
.btn.primary{background:linear-gradient(135deg,#1769aa,#148f8a)!important;border:0!important;box-shadow:0 7px 16px rgba(23,105,170,.18)}
.table th{background:#f3f7fa!important;color:#52667a!important}.table tr:hover td{background:#f8fbfd!important}
</style>


<style id="budget-theme">
.budget-kpis{grid-template-columns:repeat(4,1fr);gap:14px}.budget-bar-row{padding:12px 0;border-bottom:1px solid #eef2f5}.budget-bar-row:last-child{border-bottom:0}.budget-bar-head{display:flex;justify-content:space-between;gap:12px;font-size:10px;color:#667085}.budget-bar-head b{color:#172b4d}.budget-track{height:16px;background:#eef2f6;border-radius:99px;position:relative;overflow:hidden;margin-top:8px}.budget-plan{position:absolute;left:0;top:0;height:100%;background:#d9e5ef;border-radius:99px}.budget-actual{position:absolute;left:0;top:3px;height:10px;background:linear-gradient(90deg,#1769aa,#148f8a);border-radius:99px}.budget-percent{font-size:9px;color:#98a2b3;margin-top:5px}.budget-donut-wrap{min-height:260px;display:flex;align-items:center;justify-content:center;gap:28px}.budget-donut{width:165px;height:165px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#148f8a 0 var(--p),#dfe7ed var(--p) 100%);position:relative}.budget-donut:after{content:"";position:absolute;width:105px;height:105px;border-radius:50%;background:#fff}.budget-donut>div{position:relative;z-index:1;text-align:center}.budget-donut b{display:block;font-size:23px;color:#172b4d}.budget-donut span{font-size:9px;color:#98a2b3}.budget-legend{min-width:155px}.budget-legend p{font-size:10px;color:#667085;display:grid;grid-template-columns:9px 1fr auto;gap:7px;align-items:center;margin:12px 0}.budget-legend i{width:8px;height:8px;border-radius:50%}.budget-legend i.plan{background:#d9e5ef}.budget-legend i.actual{background:#148f8a}.budget-legend i.remain{background:#c99a3b}.budget-legend b{color:#172b4d}@media(max-width:850px){.budget-kpis{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.budget-kpis{grid-template-columns:1fr}.budget-donut-wrap{flex-direction:column}}
</style>


<style id="budget-unit-editable">
.budget-table-wrap{overflow-x:auto}.budget-table-wrap .table{min-width:820px}
.budget-table-wrap th:first-child{white-space:nowrap}.budget-table-wrap td:first-child{font-weight:700;color:#1769aa}
</style>


<style id="budget-spreadsheet-style">
.budget-spreadsheet-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;background:#f7fafc;border:1px solid #e4ebf1;border-bottom:0;border-radius:12px 12px 0 0}.budget-spreadsheet-toolbar b{display:block;font-size:12px;color:#102a43}.budget-spreadsheet-toolbar span{display:block;font-size:9px;color:#8191a5;margin-top:3px}.budget-spreadsheet{overflow:auto;max-height:620px;border:1px solid #e4ebf1;border-radius:0 0 12px 12px;background:#fff}.budget-spreadsheet table{min-width:1350px;border-collapse:separate;border-spacing:0}.budget-spreadsheet thead th{position:sticky;top:0;z-index:3;background:#102a43;color:#fff;white-space:nowrap;font-size:9px;padding:10px 8px}.budget-spreadsheet tbody td,.budget-spreadsheet tfoot td{padding:7px 8px;border-bottom:1px solid #edf1f4;vertical-align:middle;font-size:9px}.budget-spreadsheet tbody tr:hover{background:#f8fbfd}.budget-spreadsheet tbody tr:nth-child(even){background:#fcfdfe}.budget-spreadsheet tbody tr:nth-child(even):hover{background:#f6fafc}.cell-input{width:100%;min-width:110px;box-sizing:border-box;border:1px solid #dce5ec;border-radius:7px;padding:8px 8px;background:#fff;font-size:10px;color:#172b4d}.cell-input.wide{min-width:260px}.cell-input:focus{outline:none;border-color:#148f8a;box-shadow:0 0 0 2px rgba(20,143,138,.10)}.num-input{text-align:right}.row-no{text-align:center;font-weight:800;color:#1769aa}.money-cell{text-align:right;font-weight:700;white-space:nowrap;color:#172b4d}.pct-cell{text-align:right;font-weight:800;white-space:nowrap}.action-cell{white-space:nowrap}.action-cell .btn{font-size:8px;padding:6px 8px;margin:2px}.budget-total-row{position:sticky;bottom:0;background:#eef6f7;z-index:2}.budget-total-row td{border-top:2px solid #148f8a!important;color:#102a43}.badge-over{background:#fee2e2!important;color:#b42318!important}.badge-done{background:#dcfce7!important;color:#166534!important}.badge-run{background:#e0f2fe!important;color:#075985!important}.badge-zero{background:#f1f5f9!important;color:#64748b!important}.budget-legend i.over{background:#d92d20}.budget-spreadsheet::-webkit-scrollbar{width:9px;height:9px}.budget-spreadsheet::-webkit-scrollbar-thumb{background:#b8c7d3;border-radius:10px}
@media(max-width:900px){.budget-spreadsheet-toolbar{align-items:flex-start;flex-direction:column}.budget-spreadsheet{max-height:70vh}}
</style>

<style id="dashboard-budget-style">
.dashboard-budget-card{margin-top:16px}.budget-dash-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:18px}.budget-dash-kpis>div{padding:13px 15px;border:1px solid #e6edf3;border-radius:13px;background:#f9fbfd}.budget-dash-kpis span{display:block;font-size:9px;color:#8191a5;font-weight:700}.budget-dash-kpis b{display:block;margin-top:5px;font-size:16px;color:#102a43}.budget-dash-grid{gap:25px}.budget-dash-title{font-size:11px;font-weight:800;color:#52667a;margin-bottom:10px}.dash-budget-row{padding:9px 0;border-bottom:1px solid #eef2f5}.dash-budget-head{display:flex;justify-content:space-between;gap:12px;font-size:9px;color:#667085}.dash-budget-head span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dash-budget-head b{white-space:nowrap;color:#172b4d}.dash-budget-track{height:13px;background:#edf2f6;border-radius:99px;overflow:hidden;position:relative;margin-top:6px}.dash-budget-plan{position:absolute;left:0;top:0;height:100%;background:#d5e1ea;border-radius:99px}.dash-budget-actual{position:absolute;left:0;top:2px;height:9px;background:linear-gradient(90deg,#1769aa,#148f8a);border-radius:99px}.dash-budget-pct{font-size:8px;color:#98a2b3;margin-top:4px}.dash-budget-donut-wrap{min-height:205px;display:flex;align-items:center;justify-content:center;gap:24px}.dash-budget-donut{width:155px;height:155px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#148f8a 0 var(--p),#e1e8ed var(--p) 100%);position:relative}.dash-budget-donut:after{content:"";position:absolute;width:99px;height:99px;border-radius:50%;background:#fff}.dash-budget-donut>div{position:relative;z-index:1;text-align:center}.dash-budget-donut b{display:block;font-size:21px;color:#102a43}.dash-budget-donut span{font-size:9px;color:#98a2b3}.budget-dash-legend{min-width:155px}.budget-dash-legend div{display:grid;grid-template-columns:8px 1fr auto;gap:7px;align-items:center;margin:10px 0;font-size:9px;color:#667085}.budget-dash-legend i{width:7px;height:7px;border-radius:50%}.budget-dash-legend i.plan{background:#d5e1ea}.budget-dash-legend i.actual{background:#148f8a}.budget-dash-legend i.remain{background:#c99a3b}.budget-dash-legend b{color:#172b4d}@media(max-width:850px){.budget-dash-kpis{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.budget-dash-kpis{grid-template-columns:1fr}.dash-budget-donut-wrap{flex-direction:column}}
</style>


<style id="central-coa-tools">
.central-info-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.central-stat{padding:13px;border:1px solid #e8edf3;border-radius:13px;background:#f9fbfd}.central-stat span{display:block;font-size:9px;color:#8191a5;font-weight:700}.central-stat b{display:block;margin-top:5px;font-size:17px;color:#102a43}.central-stat small{display:block;margin-top:4px;font-size:9px;color:#98a2b3}.coa-tools{display:flex;gap:7px;flex-wrap:wrap}.account-posting{display:grid;grid-template-columns:1fr 1fr;gap:10px}.file-note{font-size:11px;color:#667085}@media(max-width:1100px){.central-info-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:600px){.central-info-grid{grid-template-columns:repeat(2,1fr)}}
</style>
<style id="asset-management-style">
.asset-kpis{margin-bottom:4px}.asset-kpis .kpi{min-height:118px}.asset-table-wrap{overflow:auto}.asset-table{min-width:1500px}.asset-table input,.asset-table select{width:100%;min-width:90px}.asset-badge{display:inline-block;padding:4px 8px;border-radius:999px;background:#eef5f7;color:#1769aa;font-size:9px;font-weight:800}.asset-badge.bad{background:#fff1f0;color:#b42318}.asset-badge.good{background:#ecfdf3;color:#067647}.asset-mini{font-size:9px;color:#667085}.asset-progress{height:8px;background:#edf2f6;border-radius:99px;overflow:hidden;margin-top:5px}.asset-progress>i{display:block;height:100%;background:linear-gradient(90deg,#1769aa,#148f8a);border-radius:99px}.asset-summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.asset-summary-grid>div{padding:12px;border:1px solid #e6edf3;border-radius:12px;background:#f9fbfd}.asset-summary-grid span{display:block;font-size:9px;color:#8191a5}.asset-summary-grid b{display:block;margin-top:5px;font-size:15px;color:#102a43}.asset-form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.asset-form-grid .full{grid-column:1/-1}.asset-policy{font-size:11px;line-height:1.55;color:#667085}@media(max-width:850px){.asset-summary-grid{grid-template-columns:repeat(2,1fr)}.asset-form-grid{grid-template-columns:1fr}}
</style>
</head>
<body>

<div class="login-screen" id="loginScreen">
 <div class="login-box">
  <div class="login-brand">AL BAYAN <span>WINPRO ACC</span></div>
  <div class="login-sub">Sistem Informasi Akuntansi & Laporan Keuangan</div>
  <div class="form">
   <div class="field"><label>Username</label><input id="loginUser" autocomplete="username" placeholder="Masukkan username"></div>
   <div class="field"><label>Password</label><input id="loginPass" type="password" autocomplete="current-password" placeholder="Masukkan password" onkeydown="if(event.key==='Enter')login()"></div>
   <button class="btn primary" style="width:100%;margin-top:5px" onclick="login()">Masuk</button>
   <div id="loginMsg" style="font-size:12px;color:#b42318;margin-top:10px"></div>
  </div>
  <div style="font-size:11px;color:#98a2b3;margin-top:18px">Login awal: <b>admin</b> / <b>admin123</b>. Segera ubah password melalui Pengaturan.</div>
 </div>
</div>
<div class="app">
<aside class="sidebar">
<div class="brand">AL BAYAN <span>WINPRO ACC</span></div>
<div class="nav">
<small>Monitoring</small>
<button class="active" data-page="dashboard">▣ Dashboard</button>
<button data-page="evaluation">◈ Evaluasi & Rasio</button>
<small>Transaksi</small>
<button data-page="journal">✎ Jurnal Umum</button>
<button data-page="ledger">▤ Buku Besar</button>
<button data-page="cash">◉ Kas & Bank</button>
<small>Laporan</small>
<button data-page="trial">▦ Neraca Saldo</button>
<button data-page="income">▥ Laba Rugi</button>
<button data-page="balance">▤ Neraca</button>
<button data-page="cashflow">↕ Arus Kas</button>
<button data-page="equity">◎ Perubahan Ekuitas</button>
<small>Master & Sistem</small>
<button data-page="budget">◫ Anggaran vs Realisasi</button>
<button data-page="assets">▣ Manajemen Aset</button>
<button data-page="coa">☷ COA / Akun</button>
<button data-page="settings">⚙ Pengaturan</button>
<button data-page="exports">⇩ Export / Import Laporan</button>
</div>
</aside>
<main class="main">
<div class="top"><div><h1 id="pageTitle">Dashboard</h1><div id="periodText" style="font-size:12px;color:#667085"></div></div><div class="actions"><div class="userbar"><span class="userchip" id="currentUser">admin</span><button class="btn" onclick="openPassword()">🔐 Sandi</button><button class="btn danger" onclick="logout()">↪ Logout</button></div><button class="btn good" onclick="openAutoJournal()">⚡ Transaksi</button><button class="btn" onclick="exportData()">Export Data</button><button class="btn" onclick="document.getElementById('importFile').click()">Import</button><input id="importFile" type="file" accept=".json" hidden></div></div>


<section id="budget" class="page">
  <div class="dash-head">
    <div>
      <div class="dash-kicker">AL BAYAN HIDAYATULLAH MAKASSAR</div>
      <h2>ANGGARAN VS REALISASI</h2>
      <p>Monitoring rencana anggaran, realisasi, selisih, dan persentase penyerapan.</p>
    </div>
    <div class="toolbar"><button class="btn primary" onclick="openBudgetForm()">＋ Tambah Anggaran</button><button class="btn" onclick="exportCurrentReportExcel('budgetTable','Anggaran vs Realisasi')">Excel</button><button class="btn" onclick="exportCurrentReportPDF('budgetTable','Anggaran vs Realisasi')">PDF</button></div>
  </div>

  <div class="kpi-grid budget-kpis">
    <div class="kpi"><div class="label">Total Anggaran</div><div class="value" id="budgetPlan">Rp0</div><div class="trend">Rencana periode</div></div>
    <div class="kpi"><div class="label">Total Realisasi</div><div class="value" id="budgetActual">Rp0</div><div class="trend">Realisasi tercatat</div></div>
    <div class="kpi"><div class="label">Penyerapan</div><div class="value" id="budgetPct">0%</div><div class="trend">Realisasi ÷ Anggaran</div></div>
    <div class="kpi"><div class="label">Sisa Anggaran</div><div class="value" id="budgetRemain">Rp0</div><div class="trend">Anggaran − Realisasi</div></div>
  </div>

  <div class="grid g2 section">
    <div class="card">
      <div class="card-head"><div><h3>Grafik Anggaran vs Realisasi</h3><p>Perbandingan setiap akun/kegiatan</p></div></div>
      <div id="budgetChart"></div>
    </div>
    <div class="card">
      <div class="card-head"><div><h3>Persentase Penyerapan</h3><p>Distribusi realisasi terhadap rencana</p></div></div>
      <div id="budgetDonut" class="budget-donut-wrap"></div>
    </div>
  </div>

  <div class="card section">
    <div class="card-head"><div><h3>Detail Anggaran</h3><p>Edit atau hapus jika terdapat kesalahan input</p></div></div>
    <div id="budgetTable"></div>
  </div>
</section>
<section id="dashboard" class="page active">
<div class="dash-head">
  <div>
    <div class="dash-kicker">AL BAYAN HIDAYATULLAH MAKASSAR</div>
    <h2>DASHBOARD KEUANGAN</h2>
    <p id="dashSubtitle">Ringkasan penerimaan pendidikan, beban, posisi aset, dan kesehatan keuangan secara real-time.</p>
  </div>
  <div class="dash-period"><span>PERIODE</span><b id="dashPeriod">-</b></div>
</div>

<div class="kpi-grid dash-kpis">
  <div class="kpi kpi-primary"><div class="kpi-top"><div class="icon">💰</div><span class="kpi-tag">LIKUIDITAS</span></div><div class="label">Kas & Bank</div><div class="value" id="mCash">Rp0</div><div class="trend" id="cashInfo">Saldo tersedia</div></div>
  <div class="kpi"><div class="kpi-top"><div class="icon">🏫</div><span class="kpi-tag">PERIODE</span></div><div class="label">Penerimaan/Pendapatan</div><div class="value" id="mRevenue">Rp0</div><div class="trend" id="revenueInfo">Periode berjalan</div></div>
  <div class="kpi"><div class="kpi-top"><div class="icon">↘</div><span class="kpi-tag">PERIODE</span></div><div class="label">Beban</div><div class="value" id="mExpense">Rp0</div><div class="trend" id="expenseInfo">Periode berjalan</div></div>
  <div class="kpi"><div class="kpi-top"><div class="icon">◈</div><span class="kpi-tag">HASIL</span></div><div class="label">Surplus/(Defisit)</div><div class="value" id="mProfit">Rp0</div><div class="trend" id="profitPct">Margin 0%</div></div>
  <div class="kpi"><div class="kpi-top"><div class="icon">▣</div><span class="kpi-tag">POSISI</span></div><div class="label">Total Aset</div><div class="value" id="mAssets">Rp0</div><div class="trend">Posisi akhir periode</div></div>
  <div class="kpi"><div class="kpi-top"><div class="icon">✓</div><span class="kpi-tag">KONTROL</span></div><div class="label">Status Neraca</div><div class="value small" id="mBalanceStatus">SEIMBANG</div><div class="trend" id="balanceInfo">Aset = Liabilitas + Ekuitas</div></div>
</div>

<div class="dashboard-grid dash-main">
  <div class="card chart-card">
    <div class="card-head"><div><h3>Posisi Keuangan</h3><p>Aset, liabilitas dan ekuitas pada posisi saat ini</p></div><span class="mini-badge">REAL-TIME</span></div>
    <div class="chart-box tall"><canvas id="balanceChart" height="240"></canvas></div>
  </div>
  <div class="card">
    <div class="card-head"><div><h3>Komposisi Penerimaan & Beban</h3><p>Perbandingan nilai periode berjalan</p></div></div>
    <div id="financeMix" class="finance-mix"></div>
  </div>
</div>


<div class="grid g2 section ranking-grid">
  <div class="card ranking-card">
    <div class="card-head">
      <div><h3>Ranking Penerimaan/Pendapatan</h3><p>Akun penerimaan terbesar pada periode berjalan</p></div>
      <span class="mini-badge">TOP 10</span>
    </div>
    <div id="incomeRanking"></div>
  </div>
  <div class="card ranking-card">
    <div class="card-head">
      <div><h3>Ranking Pengeluaran/Beban</h3><p>Akun beban terbesar pada periode berjalan</p></div>
      <span class="mini-badge">TOP 10</span>
    </div>
    <div id="expenseRanking"></div>
  </div>
</div>
<div class="card section ranking-chart-card">
  <div class="card-head">
    <div><h3>Grafik Ranking Keuangan</h3><p>Perbandingan akun berdasarkan nilai dan persentase dari total masing-masing kelompok</p></div>
  </div>
  <div id="rankingBars"></div>
</div>


<div id="dashboardBudgetVsRealization" class="card section dashboard-budget-card">
  <div class="card-head">
    <div><h3>Anggaran VS Realisasi</h3><p>Ringkasan rencana, realisasi, sisa anggaran, dan tingkat penyerapan</p></div>
    <button class="btn" onclick="showPage('budget')">Lihat Detail →</button>
  </div>
  <div class="budget-dash-kpis">
    <div><span>Total Anggaran</span><b id="dashBudgetPlan">Rp0</b></div>
    <div><span>Total Realisasi</span><b id="dashBudgetActual">Rp0</b></div>
    <div><span>Penyerapan</span><b id="dashBudgetPct">0%</b></div>
    <div><span>Sisa Anggaran</span><b id="dashBudgetRemain">Rp0</b></div>
  </div>
  <div class="grid g2 budget-dash-grid">
    <div>
      <div class="budget-dash-title">Grafik Anggaran VS Realisasi</div>
      <div id="dashBudgetBars"></div>
    </div>
    <div>
      <div class="budget-dash-title">Persentase Penyerapan</div>
      <div class="dash-budget-donut-wrap">
        <div id="dashBudgetDonut" class="dash-budget-donut"><div><b>0%</b><span>Realisasi</span></div></div>
        <div id="dashBudgetLegend" class="budget-dash-legend"></div>
      </div>
    </div>
  </div>
</div>

<div class="card section" id="dashboardCentralInfo"><div class="card-head"><div><h3>Pusat Informasi Sistem</h3><p>Seluruh data utama dapat dipantau dari dashboard depan</p></div><span class="mini-badge" id="systemHealthBadge">SIAP</span></div><div class="central-info-grid" id="centralInfoGrid"></div></div>

<div class="grid g3 section dash-lower">
  <div class="card"><div class="card-head"><div><h3>Kontrol Akuntansi</h3><p>Validasi kondisi laporan</p></div></div><div id="alerts"></div></div>
  <div class="card"><div class="card-head"><div><h3>Ringkasan Posisi</h3><p>Snapshot keuangan yayasan</p></div></div><div id="summary"></div></div>
  <div class="card"><div class="card-head"><div><h3>Aktivitas Transaksi</h3><p>Distribusi berdasarkan jumlah transaksi</p></div></div><div id="activity"></div></div>
</div>

<div class="card section">
  <div class="card-head"><div><h3>Transaksi Terbaru</h3><p>Jurnal terakhir yang tercatat dalam sistem</p></div><button class="btn primary" onclick="openAutoJournal()">＋ Transaksi</button></div>
  <div id="recent"></div>
</div>
</section>
<section id="evaluation" class="page"><div class="grid g4" id="ratios"></div><div class="card section"><h3>Evaluasi Keuangan</h3><div id="evaluationText"></div></div></section>

<section id="journal" class="page"><div class="card"><div class="toolbar"><button class="btn primary" onclick="openJournal()">+ Jurnal Manual</button><button class="btn good" onclick="openAutoJournal()">⚡ Jurnal Otomatis</button><button class="btn" onclick="exportCurrentReportExcel('journalTable','Jurnal Umum')">Excel</button><button class="btn" onclick="exportCurrentReportPDF('journalTable','Jurnal Umum')">PDF</button><input id="journalSearch" placeholder="Cari nomor, tanggal, deskripsi..." oninput="renderJournal()"></div><div id="journalTable"></div></div></section>
<section id="ledger" class="page"><div class="card"><div class="toolbar"><select id="ledgerAccount" onchange="renderLedger()"></select><button class="btn" onclick="exportCurrentReportExcel('ledgerTable','Buku Besar')">Excel</button><button class="btn" onclick="exportCurrentReportPDF('ledgerTable','Buku Besar')">PDF</button></div><div id="ledgerTable"></div></div></section>
<section id="cash" class="page"><div class="card"><div class="toolbar"><button class="btn primary" onclick="openJournal(true)">+ Transaksi Kas/Bank</button><button class="btn" onclick="exportCurrentReportExcel('cashTable','Kas dan Bank')">Excel</button><button class="btn" onclick="exportCurrentReportPDF('cashTable','Kas dan Bank')">PDF</button></div><div id="cashTable"></div></div></section>


<div id="cashFlowVisuals" class="cashflow-visuals section">
  <div class="grid g2">
    <div class="card">
      <div class="card-head"><div><h3>Komposisi Arus Kas</h3><p>Perbandingan arus kas masuk dan keluar</p></div><span class="mini-badge">%</span></div>
      <div id="cashFlowBars"></div>
    </div>
    <div class="card">
      <div class="card-head"><div><h3>Persentase Arus Kas</h3><p>Proporsi kas masuk, kas keluar, dan neto</p></div></div>
      <div id="cashFlowPercentChart" class="cash-percent-chart"></div>
    </div>
  </div>
</div>
<section id="trial" class="page"><div class="card"><div class="toolbar"><input type="date" id="trialFrom" onchange="renderReports()"><input type="date" id="trialTo" onchange="renderReports()"><button class="btn" onclick="exportCurrentReportPDF('trialTable','Neraca Saldo')">PDF</button><button class="btn" onclick="exportCurrentReportExcel('trialTable','Neraca Saldo')">Excel</button></div><div id="trialTable"></div></div></section>
<section id="income" class="page"><div class="card"><div class="toolbar"><button class="btn" onclick="exportCurrentReportPDF('incomeTable','Laba Rugi')">PDF</button><button class="btn" onclick="exportCurrentReportExcel('incomeTable','Laba Rugi')">Excel</button></div><div id="incomeTable"></div></div></section>
<section id="balance" class="page"><div class="card"><div class="toolbar"><button class="btn" onclick="exportCurrentReportPDF('balanceTable','Neraca')">PDF</button><button class="btn" onclick="exportCurrentReportExcel('balanceTable','Neraca')">Excel</button></div><div id="balanceTable"></div></div></section>
<section id="cashflow" class="page"><div class="card"><div class="toolbar"><button class="btn" onclick="exportCurrentReportPDF('cashflowTable','Arus Kas')">PDF</button><button class="btn" onclick="exportCurrentReportExcel('cashflowTable','Arus Kas')">Excel</button></div><div id="cashflowTable"></div></div></section>
<section id="equity" class="page"><div class="card"><div class="toolbar"><button class="btn" onclick="exportCurrentReportPDF('equityTable','Perubahan Ekuitas')">PDF</button><button class="btn" onclick="exportCurrentReportExcel('equityTable','Perubahan Ekuitas')">Excel</button></div><div id="equityTable"></div></div></section>


<div id="equityVisuals" class="equity-visuals section">
  <div class="grid g2">
    <div class="card">
      <div class="card-head"><div><h3>Komposisi Ekuitas/Dana</h3><p>Nilai dan persentase setiap akun ekuitas</p></div><span class="mini-badge">%</span></div>
      <div id="equityBars"></div>
    </div>
    <div class="card">
      <div class="card-head"><div><h3>Grafik Persentase Ekuitas</h3><p>Distribusi kontribusi akun terhadap total ekuitas</p></div></div>
      <div id="equityPercentChart" class="equity-percent-chart"></div>
    </div>
  </div>
</div>
<section id="assets" class="page">
  <div class="dash-head">
    <div><div class="dash-kicker">AL BAYAN HIDAYATULLAH MAKASSAR</div><h2>MANAJEMEN ASET TETAP</h2><p>Register aset, perolehan, penyusutan, nilai buku, mutasi, dan penghentian pengakuan terintegrasi dengan jurnal serta laporan keuangan.</p></div>
    <button class="btn primary" onclick="openAssetForm()">＋ Tambah Aset</button>
  </div>
  <div class="kpi-grid asset-kpis">
    <div class="kpi"><div class="label">Nilai Perolehan</div><div class="value" id="assetCostKpi">Rp0</div><div class="trend">Aset tetap terdaftar</div></div>
    <div class="kpi"><div class="label">Akumulasi Penyusutan</div><div class="value" id="assetAccumKpi">Rp0</div><div class="trend">Sampai periode aktif</div></div>
    <div class="kpi"><div class="label">Nilai Buku</div><div class="value" id="assetBookKpi">Rp0</div><div class="trend">Perolehan − akumulasi</div></div>
    <div class="kpi"><div class="label">Beban Penyusutan Periode</div><div class="value" id="assetPeriodDepKpi">Rp0</div><div class="trend">Jurnal penyusutan periode</div></div>
  </div>
  <div class="grid g2 section">
    <div class="card"><div class="card-head"><div><h3>Kontrol Penyusutan</h3><p>Posting penyusutan hanya sekali untuk setiap aset dan periode.</p></div><button class="btn good" onclick="postAllAssetDepreciation()">⚡ Posting Penyusutan Periode</button></div><div id="assetDepSummary"></div></div>
    <div class="card"><div class="card-head"><div><h3>Dasar Akuntansi</h3><p>Konfigurasi standar dan kebijakan aset.</p></div></div><div class="notice">SAK EP Bab 17: penyusutan dimulai ketika aset tersedia untuk digunakan, jumlah tersusutkan dialokasikan secara sistematis selama umur manfaat, dan metode mencerminkan pola konsumsi manfaat ekonomik. Sistem menyediakan garis lurus, saldo menurun, dan unit produksi.</div></div>
  </div>
  <div class="card section"><div class="card-head"><div><h3>Register Aset Tetap</h3><p>Semua aset dapat dilihat, diedit, diekspor, dan ditelusuri ke jurnal.</p></div><div class="toolbar"><input id="assetSearch" placeholder="Cari kode, nama, lokasi..." oninput="renderAssets()"><select id="assetStatusFilter" onchange="renderAssets()"><option value="">Semua status</option><option>Aktif</option><option>Dilepas</option><option>Fully Depreciated</option></select><button class="btn" onclick="exportAssetsCSV()">Export CSV</button><button class="btn" onclick="exportAssetsJSON()">Export JSON</button><button class="btn good" onclick="document.getElementById('assetImportFile').click()">Import Massal</button><input id="assetImportFile" type="file" accept=".csv,.json" hidden></div></div><div id="assetTable"></div></div>
  <div class="card section"><div class="card-head"><div><h3>Jadwal Penyusutan</h3><p>Perhitungan berdasarkan tanggal tersedia, umur manfaat, nilai residu, dan metode yang dipilih.</p></div></div><div id="assetScheduleTable"></div></div>
</section>
<section id="coa" class="page"><div class="card"><div class="toolbar"><button class="btn primary" onclick="openAccount()">+ Tambah Akun</button><button class="btn" onclick="exportCOAJSON()">Export Akun JSON</button><button class="btn" onclick="exportCOACSV()">Export Akun CSV</button><button class="btn" onclick="exportCurrentReportExcel('coaTable','COA Akun')">Excel</button><button class="btn" onclick="exportCurrentReportPDF('coaTable','COA Akun')">PDF</button><button class="btn good" onclick="downloadCOATemplate()">Template CSV</button><button class="btn" onclick="document.getElementById('coaImportFile').click()">Import Akun</button><input id="coaImportFile" type="file" accept=".csv,.json" hidden><input id="coaSearch" placeholder="Cari kode/nama akun..." oninput="renderCOA()"><select id="coaType" onchange="renderCOA()"><option value="">Semua tipe</option><option>Asset</option><option>Liability</option><option>Equity</option><option>Revenue</option><option>Expense</option></select></div><div class="notice">COA dikelola penuh: tambah, edit kode/nama/kelompok/tipe/saldo normal/status posting, hapus dengan pengalihan transaksi bila sudah digunakan, serta import/export detail maupun massal. Histori jurnal tetap dijaga saat kode akun diubah.</div><div id="coaTable" style="margin-top:12px"></div></div></section>

<section id="exports" class="page">
  <div class="dash-head"><div><div class="dash-kicker">AL BAYAN HIDAYATULLAH MAKASSAR</div><h2>PUSAT EXPORT / IMPORT LAPORAN</h2><p>Export seluruh laporan ke Excel/PDF dan import data Excel terstruktur tanpa menghapus data lama.</p></div></div>
  <div class="grid g3 section">
    <div class="card"><h3>Excel</h3><p>Workbook Excel-compatible berisi seluruh laporan + data master.</p><div class="toolbar"><button class="btn primary" onclick="exportAllReportsExcel()">⇩ Export Semua Excel</button><button class="btn" onclick="document.getElementById('excelImportFile').click()">⇧ Import Excel</button><input id="excelImportFile" type="file" accept=".xls,.csv" hidden></div></div>
    <div class="card"><h3>PDF</h3><p>Seluruh laporan digabung dalam satu dokumen siap disimpan sebagai PDF.</p><div class="toolbar"><button class="btn primary" onclick="exportAllReportsPDF()">⇩ Export Semua PDF</button><button class="btn" onclick="document.getElementById('pdfImportFile').click()">⇧ Import PDF</button><input id="pdfImportFile" type="file" accept="application/pdf,.pdf" hidden></div><small style="color:#667085">PDF adalah format publikasi/arsip, bukan format database. Import PDF disimpan sebagai arsip; untuk memulihkan data gunakan Excel terstruktur atau Backup JSON.</small></div>
    <div class="card"><h3>Backup Sistem</h3><p>Backup JSON menyimpan struktur database aplikasi secara lengkap.</p><div class="toolbar"><button class="btn good" onclick="exportData()">⇩ Backup JSON</button><button class="btn" onclick="document.getElementById('importFile').click()">⇧ Restore JSON</button></div></div>
  </div>
  <div class="card section"><div class="card-head"><div><h3>Daftar Laporan yang Diekspor</h3><p>Neraca Saldo • Laba Rugi • Neraca • Arus Kas • Perubahan Ekuitas • Jurnal • Buku Besar • Kas/Bank • Anggaran • Aset • COA</p></div></div><div id="exportReportStatus" class="notice">Export Excel membuat satu workbook dengan banyak sheet. Import Excel hanya memproses sheet data terstruktur (COA, ANGGARAN, ASET, JURNAL); laporan hasil perhitungan tetap mengikuti jurnal.</div></div>
</section>
<section id="settings" class="page"><div class="grid g2">
<div class="card form"><h3>Identitas Entitas</h3><div class="field"><label>AL BAYAN HIDAYATULLAH MAKASSAR</label><input id="setName"></div><div class="field"><label>Periode</label><input id="setPeriod" type="month"></div><div class="field"><label>Pilar Standar</label><select id="setStandard"><option>SAK Indonesia</option><option>SAK Entitas Privat (EP)</option><option>SAK EMKM</option><option>SAK Internasional</option></select></div><button class="btn primary" onclick="saveSettings()">Simpan Pengaturan</button></div>
<div class="card"><h3>Keamanan & Pengguna</h3><p style="font-size:13px;color:#667085">Kelola username dan password pengguna aktif.</p><button class="btn primary" onclick="openPassword()">Ubah Username / Password</button><hr><h3>Manajemen Data</h3><p style="font-size:13px;color:#667085">Semua data disimpan lokal di browser perangkat ini. Gunakan Export Data untuk backup dan pindahkan data ke perangkat lain melalui Import.</p><button class="btn danger" onclick="resetData()">Reset seluruh data</button><hr><p style="font-size:12px;color:#667085">Basis pelaporan: IAI/KSPKI dan SAK yang dipilih. Aplikasi ini adalah mesin pembukuan dan pelaporan; penerapan standar untuk laporan resmi tetap memerlukan penilaian profesional atas transaksi dan kebijakan akuntansi entitas.</p></div>
</div></section>
</main></div>

<div class="modal" id="modal"><div class="modalbox" id="modalBox"></div></div>
<script>
const KEY='finpro_accounting_v1';
const defaultCOA=[
['1000','ASET','Asset','Debit'],['1100','Aset Lancar','Asset','Debit'],['1101','Kas','Asset','Debit'],['1102','Bank','Asset','Debit'],['1103','Piutang Usaha','Asset','Debit'],['1104','Piutang Lain-lain','Asset','Debit'],['1105','Persediaan Barang Dagang','Asset','Debit'],['1106','Persediaan Bahan','Asset','Debit'],['1107','Uang Muka Pembelian','Asset','Debit'],['1108','Biaya Dibayar Dimuka','Asset','Debit'],['1109','Pajak Dibayar Dimuka','Asset','Debit'],
['1200','Aset Tetap','Asset','Debit'],['1201','Tanah','Asset','Debit'],['1202','Bangunan','Asset','Debit'],['1203','Kendaraan','Asset','Debit'],['1204','Peralatan Kantor','Asset','Debit'],['1205','Mesin','Asset','Debit'],['1291','Akumulasi Penyusutan Bangunan','Asset','Credit'],['1292','Akumulasi Penyusutan Kendaraan','Asset','Credit'],['1293','Akumulasi Penyusutan Peralatan','Asset','Credit'],['1294','Akumulasi Penyusutan Mesin','Asset','Credit'],
['1300','Aset Tidak Lancar Lainnya','Asset','Debit'],['1301','Investasi Jangka Panjang','Asset','Debit'],['1302','Aset Takberwujud','Asset','Debit'],['1391','Akumulasi Amortisasi','Asset','Credit'],
['2000','LIABILITAS','Liability','Credit'],['2100','Liabilitas Jangka Pendek','Liability','Credit'],['2101','Utang Usaha','Liability','Credit'],['2102','Utang Gaji','Liability','Credit'],['2103','Utang Pajak','Liability','Credit'],['2104','Pendapatan Diterima Dimuka','Liability','Credit'],['2105','Utang Biaya','Liability','Credit'],['2106','Utang Lain-lain','Liability','Credit'],['2200','Liabilitas Jangka Panjang','Liability','Credit'],['2201','Pinjaman Bank Jangka Panjang','Liability','Credit'],['2202','Liabilitas Sewa','Liability','Credit'],
['3000','EKUITAS','Equity','Credit'],['3101','Modal Disetor','Equity','Credit'],['3102','Modal Pemilik','Equity','Credit'],['3201','Saldo Laba','Equity','Credit'],['3202','Laba Tahun Berjalan','Equity','Credit'],['3301','Prive','Equity','Debit'],['3302','Pengambilan Modal','Equity','Debit'],
['4000','PENDAPATAN','Revenue','Credit'],['4101','Pendapatan Pendidikan/Yayasan','Revenue','Credit'],['4102','Pendapatan Jasa','Revenue','Credit'],['4103','Pendapatan Sewa','Revenue','Credit'],['4104','Pendapatan Hibah','Revenue','Credit'],['4201','Pendapatan Lain-lain','Revenue','Credit'],
['5000','BEBAN','Expense','Debit'],['5101','Harga Pokok Penjualan','Expense','Debit'],['5102','Pembelian','Expense','Debit'],['5201','Beban Gaji','Expense','Debit'],['5202','Beban Sewa','Expense','Debit'],['5203','Beban Listrik & Air','Expense','Debit'],['5204','Beban Internet & Komunikasi','Expense','Debit'],['5205','Beban Transportasi','Expense','Debit'],['5206','Beban Penyusutan','Expense','Debit'],['5207','Beban Perlengkapan','Expense','Debit'],['5208','Beban Administrasi Bank','Expense','Debit'],['5209','Beban Bunga','Expense','Debit'],['5210','Beban Pemeliharaan','Expense','Debit'],['5211','Beban Promosi & Marketing','Expense','Debit'],['5212','Beban Pajak','Expense','Debit'],['5213','Beban Asuransi','Expense','Debit'],['5299','Beban Lain-lain','Expense','Debit']
].map(x=>({code:x[0],name:x[1],type:x[2],normal:x[3],active:true}));
let db=JSON.parse(localStorage.getItem(KEY)||'null')||{settings:{name:'AL BAYAN HIDAYATULLAH MAKASSAR',period:new Date().toISOString().slice(0,7),standard:'SAK Entitas Privat (EP)'},coa:defaultCOA,journals:[],users:[{username:'admin',password:'admin123',role:'Administrator',active:true}],session:{loggedIn:false,username:''}}; ensureUsers();

function ensureUsers(){
 if(!db.users) db.users=[{username:'admin',password:'admin123',role:'Administrator',active:true}];
 if(!db.session) db.session={loggedIn:false,username:''};
}
function login(){
 ensureUsers();
 const u=loginUser.value.trim(), p=loginPass.value;
 const found=db.users.find(x=>x.username===u&&x.password===p&&x.active!==false);
 if(!found){loginMsg.textContent='Username atau password salah.';return}
 db.session={loggedIn:true,username:found.username};save();document.getElementById('loginScreen').style.display='none';currentUser.textContent=found.username;renderAll();
}
function logout(){ensureUsers();db.session={loggedIn:false,username:''};save();document.getElementById('loginPass').value='';document.getElementById('loginMsg').textContent='';document.getElementById('loginScreen').style.display='flex';}
function openPassword(){
 ensureUsers(); let u=db.users.find(x=>x.username===db.session.username)||db.users[0];
 modalBox.innerHTML=`<div class="modalhead"><h3>Kelola Pengguna & Password</h3><button class="x" onclick="closeModal()">×</button></div>
 <div class="form" style="margin-top:15px">
 <div class="field"><label>Username</label><input id="newUser" value="${esc(u.username)}"></div>
 <div class="field"><label>Password Lama</label><input id="oldPass" type="password"></div>
 <div class="field"><label>Password Baru</label><input id="newPass" type="password" placeholder="Minimal 6 karakter"></div>
 <div class="field"><label>Ulangi Password Baru</label><input id="newPass2" type="password"></div>
 <button class="btn primary" onclick="saveUserPassword('${esc(u.username)}')">Simpan Perubahan</button>
 </div>`;
 openModal();
}
function saveUserPassword(oldUser){
 ensureUsers(); let u=db.users.find(x=>x.username===oldUser);
 if(!u)return;
 if(oldPass.value!==u.password)return alert('Password lama salah.');
 if(!newUser.value.trim())return alert('Username wajib diisi.');
 if(newPass.value.length<6)return alert('Password baru minimal 6 karakter.');
 if(newPass.value!==newPass2.value)return alert('Konfirmasi password tidak sama.');
 if(db.users.some(x=>x.username===newUser.value.trim()&&x.username!==oldUser))return alert('Username sudah digunakan.');
 u.username=newUser.value.trim();u.password=newPass.value;db.session.username=u.username;save();currentUser.textContent=u.username;closeModal();alert('Username dan password berhasil diperbarui.');
}
function save(){localStorage.setItem(KEY,JSON.stringify(db))}
const rupiah=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(n||0);
const num=n=>new Intl.NumberFormat('id-ID').format(Math.round(n||0));
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
function accounts(){return db.coa.filter(a=>a.active).map(a=>({...a,group:a.group||''}))}
function sumAccount(code,from=null,to=null){
 let v=0; db.journals.forEach(j=>{if(from&&j.date<from)return;if(to&&j.date>to)return;j.lines.forEach(l=>{if(l.account===code)v+=Number(l.debit||0)-Number(l.credit||0)})});return v;
}
function normalBalance(a,v){return a.normal==='Debit'?v:-v}
function totals(from=null,to=null){
 let t={Asset:0,Liability:0,Equity:0,Revenue:0,Expense:0}; accounts().forEach(a=>t[a.type]+=normalBalance(a,sumAccount(a.code,from,to)));return t
}
function showPage(p){
 document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById(p).classList.add('active');
 document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===p));
 const labels={dashboard:'Dashboard',evaluation:'Evaluasi & Rasio',journal:'Jurnal Umum',ledger:'Buku Besar',cash:'Kas & Bank',trial:'Neraca Saldo',income:'Laba Rugi',balance:'Neraca',cashflow:'Arus Kas',equity:'Perubahan Ekuitas',coa:'COA / Akun',settings:'Pengaturan'};
 document.getElementById('pageTitle').textContent=labels[p];renderAll();
}
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>showPage(b.dataset.page));
function period(){return db.settings.period}
function periodBounds(){let p=period();return [p+'-01',p+'-31']}

function renderCashFlowVisuals(){
  try{
    const [f,t]=periodBounds();
    const tx=(db.journals||[]).filter(j=>j.date>=f&&j.date<=t);
    let masuk=0, keluar=0;
    tx.forEach(j=>(j.lines||[]).forEach(l=>{
      const code=String(l.account||'');
      const v=Number(l.amount)||0;
      if(!/^1101|^1102/.test(code)) return;
      if(String(l.dc).toUpperCase()==='D') masuk+=v;
      else keluar+=v;
    }));
    const net=masuk-keluar;
    const total=Math.max(masuk+keluar,1);
    const pIn=masuk/total*100, pOut=keluar/total*100, pNet=Math.abs(net)/Math.max(masuk,keluar,1)*100;

    const bars=document.getElementById('cashFlowBars');
    if(bars) bars.innerHTML=`
      <div class="cf-row"><div class="cf-head"><span>Kas Masuk</span><b>${rupiah(masuk)} · ${pIn.toFixed(1)}%</b></div>
        <div class="cf-track"><div class="cf-fill in" style="width:${Math.min(100,pIn)}%"></div></div></div>
      <div class="cf-row"><div class="cf-head"><span>Kas Keluar</span><b>${rupiah(keluar)} · ${pOut.toFixed(1)}%</b></div>
        <div class="cf-track"><div class="cf-fill out" style="width:${Math.min(100,pOut)}%"></div></div></div>
      <div class="cf-net"><span>Arus Kas Neto</span><strong>${rupiah(net)}</strong></div>`;

    const chart=document.getElementById('cashFlowPercentChart');
    if(chart){
      chart.innerHTML=`
      <div class="cf-donut" style="--in:${pIn}%;--out:${pOut}%"><div><b>${Math.round((pIn+pOut)>0?Math.abs(net)/(masuk+keluar)*100:0)}%</b><span>Neto</span></div></div>
      <div class="cf-legend">
        <div><i class="in"></i><span>Kas masuk</span><b>${pIn.toFixed(1)}%</b></div>
        <div><i class="out"></i><span>Kas keluar</span><b>${pOut.toFixed(1)}%</b></div>
      </div>`;
    }
  }catch(e){ console.warn('Cash flow visuals:',e); }
}


function renderEquityVisuals(){
  try{
    const [f,t]=periodBounds();
    const coa=(db.coa||[]).filter(a=>a.type==='Equity' && a.postable!==false && !ABYAN.accounting.isHeader(a));
    const vals={};
    coa.forEach(a=>vals[a.code]={name:a.name,code:a.code,value:0});
    (db.journals||[]).filter(j=>j.date>=f&&j.date<=t).forEach(j=>(j.lines||[]).forEach(l=>{
      const x=vals[String(l.account)]; if(!x)return;
      const v=Number(l.amount)||0;
      x.value += String(l.dc).toUpperCase()==='C'?v:-v;
    }));
    const rows=Object.values(vals).filter(x=>x.value!==0).sort((a,b)=>Math.abs(b.value)-Math.abs(a.value)).slice(0,10);
    const total=rows.reduce((s,x)=>s+Math.max(0,x.value),0)||1;
    const bars=document.getElementById('equityBars');
    if(bars) bars.innerHTML=rows.length ? rows.map((x,i)=>{
      const p=Math.max(0,x.value)/total*100;
      return `<div class="eq-row"><div class="eq-head"><span><b>${i+1}.</b> ${x.name}</span><b>${rupiah(x.value)} · ${p.toFixed(1)}%</b></div><div class="eq-code">${x.code}</div><div class="eq-track"><div class="eq-fill" style="width:${Math.min(100,p)}%"></div></div></div>`;
    }).join('') : '<div class="empty-ranking">Belum ada data ekuitas pada periode ini.</div>';

    const chart=document.getElementById('equityPercentChart');
    if(chart){
      chart.innerHTML=rows.length ? `
        <div class="eq-donut"><div><b>${rows.length}</b><span>akun</span></div></div>
        <div class="eq-legend">${rows.map(x=>{
          const p=Math.max(0,x.value)/total*100;
          return `<div><i></i><span>${x.name}</span><b>${p.toFixed(1)}%</b></div>`;
        }).join('')}</div>` : '<div class="empty-ranking">Belum ada data.</div>';
    }
  }catch(e){console.warn('Equity visuals:',e);}
}


function budgetData(){
  db.budgets=Array.isArray(db.budgets)?db.budgets:[];
  db.budgets.forEach((x,i)=>{
    x.id=x.id||('BUD-'+Date.now()+'-'+i);
    x.unit=x.unit??x.divisi??'';
    x.name=x.name??x.kegiatan??x.account??'';
    x.plan=Number(x.plan??x.budget??x.amount??0);
    x.actual=Number(x.actual??x.realization??x.realisasi??0);
    if(!Number.isFinite(x.plan)||x.plan<0)x.plan=0;
    if(!Number.isFinite(x.actual)||x.actual<0)x.actual=0;
  });
  return db.budgets;
}
function openBudgetForm(id){
  const old=(db.budgets||[]).find(x=>x.id===id);
  const unit=prompt('DEVISI/UNIT:',old?.unit||''); if(unit===null)return;
  const name=prompt('Nama anggaran/kegiatan:',old?.name||''); if(name===null)return;
  if(!String(name).trim())return alert('Nama kegiatan/akun wajib diisi.');
  const plan=Number(prompt('Nilai anggaran:',old?.plan??0));
  if(!Number.isFinite(plan)||plan<0){alert('Nilai anggaran tidak valid. Gunakan angka 0 atau lebih.');return;}
  const actual=Number(prompt('Nilai realisasi:',old?.actual??0));
  if(!Number.isFinite(actual)||actual<0){alert('Nilai realisasi tidak valid. Gunakan angka 0 atau lebih.');return;}
  if(old){old.unit=String(unit).trim();old.name=String(name).trim();old.plan=plan;old.actual=actual;}
  else (db.budgets=db.budgets||[]).push({id:'BUD-'+Date.now(),unit:String(unit).trim(),name:String(name).trim(),plan,actual});
  saveDB(); renderBudgetPage(); renderDashboardBudget(); renderCentral();
}
function saveBudgetRow(id){
  const x=(db.budgets||[]).find(a=>a.id===id); if(!x)return;
  const row=document.querySelector('[data-budget-id="'+CSS.escape(id)+'"]'); if(!row)return;
  const unit=row.querySelector('.b-unit').value.trim();
  const name=row.querySelector('.b-name').value.trim();
  const plan=Number(row.querySelector('.b-plan').value);
  const actual=Number(row.querySelector('.b-actual').value);
  if(!name)return alert('Nama kegiatan/akun wajib diisi.');
  if(!Number.isFinite(plan)||plan<0)return alert('Anggaran tidak valid.');
  if(!Number.isFinite(actual)||actual<0)return alert('Realisasi tidak valid.');
  x.unit=unit;x.name=name;x.plan=plan;x.actual=actual;
  saveDB();renderBudgetPage();renderDashboardBudget();renderCentral();
}
function editBudgetInline(id){saveBudgetRow(id)}
function deleteBudget(id){
  if(!confirm('Hapus data anggaran ini?'))return;
  db.budgets=(db.budgets||[]).filter(x=>x.id!==id); saveDB(); renderBudgetPage(); renderDashboardBudget(); renderCentral();
}
function renderBudgetPage(){
  const rows=budgetData();
  const plan=rows.reduce((s,x)=>s+(Number(x.plan)||0),0);
  const actual=rows.reduce((s,x)=>s+(Number(x.actual)||0),0);
  const pct=plan?actual/plan*100:0;
  const remain=plan-actual;
  const over=rows.reduce((s,x)=>s+Math.max(0,(Number(x.actual)||0)-(Number(x.plan)||0)),0);
  const set=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v};
  set('budgetPlan',rupiah(plan)); set('budgetActual',rupiah(actual)); set('budgetPct',pct.toFixed(1)+'%'); set('budgetRemain',rupiah(remain));

  const max=Math.max(...rows.map(x=>Number(x.plan)||0),1);
  const chart=document.getElementById('budgetChart');
  if(chart) chart.innerHTML=rows.length?rows.map((x,i)=>{
    const p=Number(x.plan)||0,a=Number(x.actual)||0;
    const rp=p?a/p*100:0;
    return `<div class="budget-bar-row"><div class="budget-bar-head"><span>${i+1}. ${esc(x.unit||'Umum')} — ${esc(x.name)}</span><b>${rupiah(a)} / ${rupiah(p)}</b></div><div class="budget-track"><div class="budget-plan" style="width:${Math.min(100,p/max*100)}%"></div><div class="budget-actual" style="width:${Math.min(100,a/max*100)}%"></div></div><div class="budget-percent">${rp.toFixed(1)}% terealisasi • Sisa ${rupiah(p-a)}</div></div>`;
  }).join(''):'<div class="empty-ranking">Belum ada data anggaran.</div>';

  const d=document.getElementById('budgetDonut');
  if(d){const share=plan?Math.min(100,Math.max(0,pct)):0; d.innerHTML=`<div class="budget-donut" style="--p:${share}%"><div><b>${pct.toFixed(1)}%</b><span>Realisasi</span></div></div><div class="budget-legend"><p><i class="plan"></i> Anggaran <b>${rupiah(plan)}</b></p><p><i class="actual"></i> Realisasi <b>${rupiah(actual)}</b></p><p><i class="remain"></i> Sisa <b>${rupiah(remain)}</b></p>${over?`<p><i class="over"></i> Over Budget <b>${rupiah(over)}</b></p>`:''}</div>`;}

  const table=document.getElementById('budgetTable');
  if(!table)return;
  table.innerHTML=rows.length?`
    <div class="budget-spreadsheet-toolbar">
      <div><b>HAMparan ANGGARAN & REALISASI PROGRAM</b><span>${rows.length} program/kegiatan • dapat diedit langsung</span></div>
      <button class="btn primary" onclick="openBudgetForm()">＋ Tambah Baris</button>
    </div>
    <div class="budget-table-wrap budget-spreadsheet">
      <table class="table budget-edit-table">
        <thead><tr>
          <th>NO</th><th>DEVISI / UNIT</th><th>PROGRAM / KEGIATAN / AKUN</th>
          <th>ANGGARAN</th><th>REALISASI</th><th>SISA</th><th>% REALISASI</th><th>% SISA</th><th>STATUS</th><th>AKSI</th>
        </tr></thead>
        <tbody>${rows.map((x,i)=>{
          const p=Number(x.plan)||0,a=Number(x.actual)||0,sel=p-a,pr=p?(a/p*100):0,sisaPct=p?(sel/p*100):0;
          const status=a>p?'OVER BUDGET':a===p&&p>0?'SELESAI':a>0?'BERJALAN':'BELUM REALISASI';
          return `<tr data-budget-id="${esc(x.id)}">
            <td class="row-no">${i+1}</td>
            <td><input class="b-unit cell-input" value="${esc(x.unit||'')}" placeholder="Unit/Divisi"></td>
            <td><input class="b-name cell-input wide" value="${esc(x.name||'')}" placeholder="Program / Kegiatan / Akun"></td>
            <td><input class="b-plan num-input cell-input" type="number" min="0" step="0.01" value="${p}"></td>
            <td><input class="b-actual num-input cell-input" type="number" min="0" step="0.01" value="${a}"></td>
            <td class="b-selisih money-cell">${rupiah(sel)}</td>
            <td class="b-pct pct-cell">${pr.toFixed(1)}%</td>
            <td class="b-sisa-pct pct-cell">${sisaPct.toFixed(1)}%</td>
            <td class="b-status"><span class="mini-badge ${a>p?'badge-over':a===p&&p>0?'badge-done':a>0?'badge-run':'badge-zero'}">${status}</span></td>
            <td class="action-cell"><button class="btn primary" onclick="saveBudgetRow('${esc(x.id)}')">Simpan</button><button class="btn danger" onclick="deleteBudget('${esc(x.id)}')">Hapus</button></td>
          </tr>`;
        }).join('')}</tbody>
        <tfoot><tr class="budget-total-row">
          <td colspan="3"><b>TOTAL ANGGARAN PROGRAM</b></td><td class="total-plan"><b>${rupiah(plan)}</b></td><td class="total-actual"><b>${rupiah(actual)}</b></td><td class="total-remain"><b>${rupiah(remain)}</b></td><td class="total-pct"><b>${pct.toFixed(1)}%</b></td><td class="total-sisa-pct"><b>${(plan?(remain/plan*100):0).toFixed(1)}%</b></td><td colspan="2"><b>${over?`OVER ${rupiah(over)}`:'TERKENDALI'}</b></td>
        </tr></tfoot>
      </table>
    </div>`:'<div class="empty-ranking">Belum ada data anggaran. Klik “Tambah Anggaran” untuk membuat item.</div>';
  bindBudgetLiveCalculation();
}

function bindBudgetLiveCalculation(){
  document.querySelectorAll('#budgetTable tr[data-budget-id]').forEach(row=>{
    const p=row.querySelector('.b-plan'),a=row.querySelector('.b-actual');
    const update=()=>{
      const plan=Number(p?.value)||0, actual=Number(a?.value)||0, remain=plan-actual, rp=plan?actual/plan*100:0, sp=plan?remain/plan*100:0;
      const s=row.querySelector('.b-selisih'),pc=row.querySelector('.b-pct'),sc=row.querySelector('.b-sisa-pct'),st=row.querySelector('.b-status span');
      if(s)s.textContent=rupiah(remain); if(pc)pc.textContent=rp.toFixed(1)+'%'; if(sc)sc.textContent=sp.toFixed(1)+'%';
      if(st){st.textContent=actual>plan?'OVER BUDGET':actual===plan&&plan>0?'SELESAI':actual>0?'BERJALAN':'BELUM REALISASI';st.className='mini-badge '+(actual>plan?'badge-over':actual===plan&&plan>0?'badge-done':actual>0?'badge-run':'badge-zero');}
    };
    p?.addEventListener('input',update); a?.addEventListener('input',update); update();
  });
}


function renderDashboardBudget(){
  try{
    const rows=(db.budgets||[]);
    const plan=rows.reduce((s,x)=>s+(Number(x.plan)||0),0);
    const actual=rows.reduce((s,x)=>s+(Number(x.actual)||0),0);
    const remain=plan-actual;
    const pct=plan?actual/plan*100:0;
    const set=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v};
    set('dashBudgetPlan',rupiah(plan)); set('dashBudgetActual',rupiah(actual));
    set('dashBudgetPct',pct.toFixed(1)+'%'); set('dashBudgetRemain',rupiah(remain));

    const bars=document.getElementById('dashBudgetBars');
    const top=rows.slice().sort((a,b)=>(Number(b.plan)||0)-(Number(a.plan)||0)).slice(0,8);
    const max=Math.max(...top.map(x=>Number(x.plan)||0),1);
    if(bars) bars.innerHTML=top.length?top.map((x,i)=>{
      const p=Number(x.plan)||0,a=Number(x.actual)||0, rp=p?Math.min(100,a/p*100):0;
      return `<div class="dash-budget-row">
        <div class="dash-budget-head"><span>${i+1}. ${x.unit||'Umum'} — ${x.name}</span><b>${rupiah(a)} / ${rupiah(p)}</b></div>
        <div class="dash-budget-track"><div class="dash-budget-plan" style="width:${p/max*100}%"></div><div class="dash-budget-actual" style="width:${a/max*100}%"></div></div>
        <div class="dash-budget-pct">${rp.toFixed(1)}% terealisasi</div>
      </div>`;
    }).join(''):'<div class="empty-ranking">Belum ada data anggaran.</div>';

    const donut=document.getElementById('dashBudgetDonut');
    if(donut){
      const safe=Math.max(0,Math.min(100,pct));
      donut.style.setProperty('--p',safe+'%');
      donut.querySelector('b').textContent=pct.toFixed(1)+'%';
    }
    const leg=document.getElementById('dashBudgetLegend');
    if(leg) leg.innerHTML=`
      <div><i class="plan"></i><span>Anggaran</span><b>${rupiah(plan)}</b></div>
      <div><i class="actual"></i><span>Realisasi</span><b>${rupiah(actual)}</b></div>
      <div><i class="remain"></i><span>Sisa</span><b>${rupiah(remain)}</b></div>`;
  }catch(e){console.warn('Dashboard budget:',e)}
}

function renderDashboard(){
  let [f,t]=periodBounds();
  const rev=totals(f,t).Revenue, exp=totals(f,t).Expense, profit=rev-exp;
  const all=totals(), cash=accounts().filter(a=>/^1101|^1102/.test(a.code))
    .reduce((s,a)=>s+normalBalance(a,sumAccount(a.code)),0);
  const assets=all.Asset, liabilities=all.Liability, equity=all.Equity;
  const balanced=Math.abs(assets-(liabilities+equity+profit))<=1;
  const margin=rev?profit/rev*100:0;

  mCash.textContent=rupiah(cash);
  mRevenue.textContent=rupiah(rev);
  mExpense.textContent=rupiah(exp);
  mProfit.textContent=rupiah(profit);
  document.getElementById('mAssets').textContent=rupiah(assets);
  document.getElementById('profitPct').textContent=(profit>=0?'Surplus ':'Defisit ')+Math.abs(margin).toFixed(1)+'%';
  document.getElementById('mBalanceStatus').textContent=balanced?'SEIMBANG':'PERIKSA';
  document.getElementById('balanceInfo').textContent=balanced?'Aset = Liabilitas + Ekuitas':'Ada selisih pada persamaan akuntansi';
  document.getElementById('cashInfo').textContent=cash>=0?'Saldo tersedia':'Saldo kas perlu diperiksa';
  document.getElementById('revenueInfo').textContent=`${db.journals.filter(j=>j.date>=f&&j.date<=t).length} transaksi periode`;
  document.getElementById('expenseInfo').textContent=rev?`Beban ${((exp/rev)*100).toFixed(1)}% dari penerimaan`:'Belum ada penerimaan';
  document.getElementById('dashPeriod').textContent=`${period()} • ${db.settings.standard||'SAK'}`;
  periodText.textContent=`${db.settings.name} • ${period()} • ${db.settings.standard}`;

  document.getElementById('summary').innerHTML=`
    <div class="summary-row"><span>Total Aset</span><b>${rupiah(assets)}</b></div>
    <div class="summary-row"><span>Liabilitas</span><b>${rupiah(liabilities)}</b></div>
    <div class="summary-row"><span>Ekuitas/Dana</span><b>${rupiah(equity+profit)}</b></div>
    <div class="summary-row"><span>Surplus/(Defisit)</span><b>${rupiah(profit)}</b></div>`;

  const alerts=[];
  if(!balanced) alerts.push('<p><span class="status-dot bad"></span><b>Perlu pemeriksaan:</b> neraca belum seimbang.</p>');
  else alerts.push('<p><span class="status-dot good"></span><b>Seimbang:</b> persamaan akuntansi terpenuhi.</p>');
  if(rev===0) alerts.push('<p><span class="status-dot warn"></span>Belum ada penerimaan/pendapatan pada periode ini.</p>');
  if(cash<0) alerts.push('<p><span class="status-dot bad"></span>Saldo kas & bank menunjukkan nilai negatif.</p>');
  if(!alerts.length) alerts.push('<p><span class="status-dot good"></span>Tidak ada peringatan utama.</p>');
  document.getElementById('alerts').innerHTML=alerts.join('');

  const tx=db.journals.filter(j=>j.date>=f&&j.date<=t);
  const counts={'Penerimaan/Pendapatan':0,'Beban':0,'Pembelian':0,'Kas/Bank':0,'Lainnya':0};
  tx.forEach(j=>{
    const s=(j.desc||'').toLowerCase();
    if(/penerimaan|pendapatan|spp|pendidikan|donasi|infak|hibah/.test(s)) counts['Penerimaan/Pendapatan']++;
    else if(/beban|gaji|listrik|sewa|transport|pemeliharaan/.test(s)) counts['Beban']++;
    else if(/pembelian|belanja/.test(s)) counts['Pembelian']++;
    else if((j.lines||[]).some(l=>/^110[12]/.test(String(l.account)))) counts['Kas/Bank']++;
    else counts['Lainnya']++;
  });
  const totalTx=Math.max(tx.length,1);
  const activityRows=Object.entries(counts).map(([k,v])=>({k,v,p:Math.round(v/totalTx*100)}));
  document.getElementById('activity').innerHTML=activityRows.map(x=>`
    <div class="activity-row"><div class="activity-label">${x.k}</div>
    <div class="activity-track"><div class="activity-fill" style="width:${Math.min(100,x.p)}%"></div></div><b>${x.p}%</b></div>`).join('')+
    `<div class="activity-note">${tx.length} transaksi tercatat pada periode ${period()}.</div>`;

  const maxMix=Math.max(rev,exp,1);
  document.getElementById('financeMix').innerHTML=`
    <div class="mix-item"><div><span>Penerimaan/Pendapatan</span><b>${rupiah(rev)}</b></div>
      <div class="mix-track"><div class="mix-fill receive" style="width:${rev/maxMix*100}%"></div></div></div>
    <div class="mix-item"><div><span>Beban</span><b>${rupiah(exp)}</b></div>
      <div class="mix-track"><div class="mix-fill expense" style="width:${exp/maxMix*100}%"></div></div></div>
    <div class="mix-result"><span>Hasil periode</span><strong>${rupiah(profit)}</strong></div>`;

  const rec=db.journals.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,8);
  recent.innerHTML=journalRows(rec);

  function rankAccounts(type){
    const map={};
    (db.coa||[]).filter(a=>a.type===type && a.postable!==false && !ABYAN.accounting.isHeader(a))
      .forEach(a=>map[a.code]={code:a.code,name:a.name,value:0});
    (db.journals||[]).filter(j=>j.date>=f&&j.date<=t).forEach(j=>(j.lines||[]).forEach(l=>{
      const x=map[String(l.account)];
      if(!x)return;
      const v=Number(l.amount)||0;
      // Revenue normal balance = credit; Expense normal balance = debit.
      x.value += (type==='Revenue' ? (String(l.dc).toUpperCase()==='C'?v:-v) : (String(l.dc).toUpperCase()==='D'?v:-v));
    }));
    return Object.values(map).filter(x=>x.value>0).sort((a,b)=>b.value-a.value).slice(0,10);
  }
  const incomeRank=rankAccounts('Revenue'), expenseRank=rankAccounts('Expense');
  function rankHtml(rows,total,kind){
    if(!rows.length)return '<div class="empty-ranking">Belum ada data pada periode ini.</div>';
    return rows.map((x,i)=>{
      const pct=total?x.value/total*100:0;
      return `<div class="rank-row">
        <div class="rank-num">${i+1}</div>
        <div class="rank-main"><div class="rank-name">${x.name}</div><div class="rank-code">${x.code}</div>
          <div class="rank-track"><div class="rank-fill ${kind}" style="width:${Math.min(100,pct)}%"></div></div>
        </div>
        <div class="rank-value"><b>${rupiah(x.value)}</b><span>${pct.toFixed(1)}%</span></div>
      </div>`;
    }).join('');
  }
  const incomeTotal=incomeRank.reduce((s,x)=>s+x.value,0), expenseTotal=expenseRank.reduce((s,x)=>s+x.value,0);
  document.getElementById('incomeRanking').innerHTML=rankHtml(incomeRank,incomeTotal,'income');
  document.getElementById('expenseRanking').innerHTML=rankHtml(expenseRank,expenseTotal,'expense');

  const chartRows=[...incomeRank.map(x=>({name:x.name, penerimaan:x.value, beban:0, pct:(incomeTotal?x.value/incomeTotal*100:0)})),
                   ...expenseRank.map(x=>({name:x.name, penerimaan:0, beban:x.value, pct:(expenseTotal?x.value/expenseTotal*100:0)}))].slice(0,20);
  document.getElementById('rankingBars').innerHTML=chartRows.length ? chartRows.map((x,i)=>{
    const v=x.penerimaan||x.beban, pct=x.pct;
    const cls=x.penerimaan?'income':'expense';
    return `<div class="bar-rank"><div class="bar-rank-head"><span>${i+1}. ${x.name}</span><b>${rupiah(v)} · ${pct.toFixed(1)}%</b></div><div class="bar-rank-track"><div class="bar-rank-fill ${cls}" style="width:${Math.min(100,pct)}%"></div></div></div>`;
  }).join('') : '<div class="empty-ranking">Belum ada data ranking.</div>';

  renderCashFlowVisuals();
  renderEquityVisuals();
  renderDashboardBudget();
  drawChart({Asset:assets,Liability:liabilities,Equity:equity+profit});
}
function drawChart(z){
  const c=document.getElementById('balanceChart'); if(!c)return;
  const ctx=c.getContext('2d'), ratio=window.devicePixelRatio||1;
  const w=Math.max(c.clientWidth,500), h=240; c.width=w*ratio; c.height=h*ratio; ctx.setTransform(ratio,0,0,ratio,0,0);
  ctx.clearRect(0,0,w,h);
  const vals=[Math.max(0,z.Asset),Math.max(0,z.Liability),Math.max(0,z.Equity)];
  const labels=['Aset','Liabilitas','Ekuitas']; const max=Math.max(...vals,1);
  const base=h-38, top=28, gap=22, bw=Math.min(110,(w-80-gap*2)/3);
  vals.forEach((v,i)=>{
    const x=35+i*(bw+gap+(w-3*bw-gap*2-70)/3), bh=Math.max(4,(v/max)*(base-top)), y=base-bh;
    ctx.fillStyle=['#1d4ed8','#f59e0b','#16a34a'][i];
    ctx.beginPath(); ctx.roundRect(x,y,bw,bh,10); ctx.fill();
    ctx.fillStyle='#344054'; ctx.font='600 13px Arial'; ctx.textAlign='center'; ctx.fillText(labels[i],x+bw/2,base+20);
    ctx.font='700 12px Arial'; ctx.fillText(rupiah(v),x+bw/2,Math.max(18,y-8));
  });
}
function journalRows(rows){if(!rows.length)return '<div class="empty">Belum ada transaksi.</div>';return '<div class="tablewrap"><table class="table"><thead><tr><th>Tanggal</th><th>No. Bukti</th><th>Deskripsi</th><th class="num">Debit</th><th class="num">Kredit</th><th></th></tr></thead><tbody>'+rows.map(j=>{let d=j.lines.reduce((s,x)=>s+Number(x.debit||0),0),c=j.lines.reduce((s,x)=>s+Number(x.credit||0),0);return `<tr><td>${j.date}</td><td>${esc(j.no)}</td><td>${esc(j.desc)}</td><td class="num">${rupiah(d)}</td><td class="num">${rupiah(c)}</td><td><button class="btn" onclick="editJournal('${j.id}')">Edit</button> <button class="btn danger" onclick="deleteJournal('${j.id}')">Hapus</button></td></tr>`}).join('')+'</tbody></table></div>'}
function renderJournal(){let q=(document.getElementById('journalSearch')?.value||'').toLowerCase();let rows=db.journals.filter(j=>[j.no,j.date,j.desc].join(' ').toLowerCase().includes(q));document.getElementById('journalTable').innerHTML=journalRows(rows)}
function renderLedger(){let sel=document.getElementById('ledgerAccount');if(!sel)return;let cur=sel.value||accounts()[0]?.code;sel.innerHTML=accounts().map(a=>`<option value="${a.code}">${a.code} — ${esc(a.name)}</option>`).join('');sel.value=cur;let a=accounts().find(x=>x.code===sel.value);let bal=0, rows=[];db.journals.slice().sort((x,y)=>x.date.localeCompare(y.date)).forEach(j=>j.lines.forEach(l=>{if(l.account===a.code){let net=Number(l.debit||0)-Number(l.credit||0);bal+=net;rows.push(`<tr><td>${j.date}</td><td>${j.no}</td><td>${esc(j.desc)}</td><td class="num">${rupiah(l.debit)}</td><td class="num">${rupiah(l.credit)}</td><td class="num">${rupiah(normalBalance(a,bal))}</td></tr>`)}}));document.getElementById('ledgerTable').innerHTML=`<h3>${a.code} — ${esc(a.name)}</h3><div class="tablewrap"><table class="table"><thead><tr><th>Tanggal</th><th>No</th><th>Deskripsi</th><th class="num">Debit</th><th class="num">Kredit</th><th class="num">Saldo</th></tr></thead><tbody>${rows.join('')||'<tr><td colspan="6" class="empty">Belum ada mutasi.</td></tr>'}</tbody></table></div>`}
function renderCash(){let cashCodes=accounts().filter(a=>a.name.toLowerCase().includes('kas')||a.name.toLowerCase().includes('bank')).map(a=>a.code);let rows=[];db.journals.forEach(j=>j.lines.forEach(l=>{if(cashCodes.includes(l.account))rows.push({...l,j})}));document.getElementById('cashTable').innerHTML=journalRows(db.journals.filter(j=>j.lines.some(l=>cashCodes.includes(l.account))))}
function renderReports(){let [f,t]=periodBounds();let z=totals(f,t);let rows=accounts().map(a=>{let v=sumAccount(a.code,f,t);return `<tr><td>${a.code}</td><td>${esc(a.name)}</td><td>${a.type}</td><td class="num">${rupiah(v>0?v:0)}</td><td class="num">${rupiah(v<0?-v:0)}</td></tr>`}).join('');document.getElementById('trialTable').innerHTML=`<h2>Neraca Saldo</h2><p>${db.settings.name} • ${period()}</p><div class="tablewrap"><table class="table"><thead><tr><th>Kode</th><th>Akun</th><th>Tipe</th><th class="num">Debit</th><th class="num">Kredit</th></tr></thead><tbody>${rows}</tbody></table></div>`;
 let rev=accounts().filter(a=>a.type==='Revenue').map(a=>[a,sumAccount(a.code,f,t)]), exp=accounts().filter(a=>a.type==='Expense').map(a=>[a,sumAccount(a.code,f,t)]), totalR=rev.reduce((s,x)=>s+normalBalance(x[0],x[1]),0), totalE=exp.reduce((s,x)=>s+normalBalance(x[0],x[1]),0);
 document.getElementById('incomeTable').innerHTML=`<h2>Laporan Laba Rugi</h2><p>${db.settings.name} • ${period()}</p>${reportSection('Pendapatan',rev,true)}<hr>${reportSection('Beban',exp,false)}<h3 class="num">Laba Bersih: ${rupiah(totalR-totalE)}</h3>`;
 let assets=accounts().filter(a=>a.type==='Asset').map(a=>[a,sumAccount(a.code,f,t)]), liab=accounts().filter(a=>a.type==='Liability').map(a=>[a,sumAccount(a.code,f,t)]), eq=accounts().filter(a=>a.type==='Equity').map(a=>[a,sumAccount(a.code,f,t)]);
 document.getElementById('balanceTable').innerHTML=`<h2>Laporan Posisi Keuangan</h2><p>${db.settings.name} • ${period()}</p>${reportSection('Aset',assets,false)}<hr>${reportSection('Liabilitas',liab,false)}${reportSection('Ekuitas',eq,false)}<h3 class="num">Total Liabilitas + Ekuitas: ${rupiah(liab.reduce((s,x)=>s+normalBalance(x[0],x[1]),0)+eq.reduce((s,x)=>s+normalBalance(x[0],x[1]),0)+totalR-totalE)}</h3>`;
 let cashAccounts=accounts().filter(a=>a.code.startsWith('1101')||a.code.startsWith('1102'));let net=0;cashAccounts.forEach(a=>net+=normalBalance(a,sumAccount(a.code,f,t)));document.getElementById('cashflowTable').innerHTML=`<h2>Laporan Arus Kas (ringkas)</h2><p>Saldo bersih kas & bank berdasarkan jurnal periode ${period()}.</p><h3>Perubahan bersih kas: ${rupiah(net)}</h3><p style="color:#667085;font-size:13px">Untuk arus kas operasional/investasi/pendanaan yang lebih detail, gunakan tagging aktivitas pada transaksi.</p>`;
 document.getElementById('equityTable').innerHTML=`<h2>Laporan Perubahan Ekuitas</h2><p>Ekuitas akhir = ekuitas sebelum laba/rugi + laba periode + transaksi ekuitas.</p><h3>Total Ekuitas Akhir: ${rupiah(eq.reduce((s,x)=>s+normalBalance(x[0],x[1]),0)+totalR-totalE)}</h3>`;
}
function reportSection(title,arr,rev){let total=arr.reduce((s,x)=>s+normalBalance(x[0],x[1]),0);return `<h3>${title}</h3><table class="table"><tbody>${arr.map(x=>`<tr><td>${x[0].code} — ${esc(x[0].name)}</td><td class="num">${rupiah(normalBalance(x[0],x[1]))}</td></tr>`).join('')}<tr><th>Total ${title}</th><th class="num">${rupiah(total)}</th></tr></tbody></table>`}
function renderCOA(){let q=(document.getElementById('coaSearch')?.value||'').toLowerCase(),ty=document.getElementById('coaType')?.value||'';let arr=db.coa.filter(a=>(!q||(a.code+' '+a.name).toLowerCase().includes(q))&&(!ty||a.type===ty));document.getElementById('coaTable').innerHTML=`<div class="tablewrap"><table class="table"><thead><tr><th>Kode</th><th>Nama Akun</th><th>Kelompok</th><th>Tipe</th><th>Saldo Normal</th><th>Status</th><th></th></tr></thead><tbody>${arr.map(a=>`<tr><td>${a.code}</td><td>${esc(a.name)}</td><td>${esc(a.group||'')}</td><td>${a.type}</td><td>${a.normal}</td><td>${a.active?'<span class="pill good">Aktif</span>':'Nonaktif'}</td><td><button class="btn" onclick="openAccount('${a.code}')">Edit</button> <button class="btn danger" onclick="deleteAccount('${a.code}')">Hapus</button></td></tr>`).join('')}</tbody></table></div>`}
function renderEvaluation(){let [f,t]=periodBounds(),z=totals(f,t), current=z.Asset-z.Liability, currentAssets=accounts().filter(a=>a.type==='Asset').reduce((s,a)=>s+normalBalance(a,sumAccount(a.code,f,t)),0),currentLiab=z.Liability, cash=accounts().filter(a=>a.code==='1101'||a.code==='1102').reduce((s,a)=>s+normalBalance(a,sumAccount(a.code,f,t)),0), profit=z.Revenue-z.Expense;let ratios=[['Current Ratio',currentLiab?currentAssets/currentLiab:0],['Debt to Asset',z.Asset?z.Liability/z.Asset:0],['Net Profit Margin',z.Revenue?profit/z.Revenue:0],['ROA',z.Asset?profit/z.Asset:0]];document.getElementById('ratios').innerHTML=ratios.map(r=>`<div class="card metric"><div class="label">${r[0]}</div><div class="value">${(r[1]* (r[0].includes('Ratio')?1:100)).toFixed(2)}${r[0].includes('Ratio')?'x':'%'}</div><div class="sub">Indikator analitis, bukan penilaian otomatis.</div></div>`).join('');document.getElementById('evaluationText').innerHTML=`<p><b>Likuiditas:</b> kas & bank ${rupiah(cash)}.</p><p><b>Profitabilitas:</b> laba bersih ${rupiah(profit)} dari pendapatan ${rupiah(z.Revenue)}.</p><p><b>Struktur modal:</b> liabilitas ${rupiah(z.Liability)} dibanding aset ${rupiah(z.Asset)}.</p><p style="color:#667085;font-size:13px">Interpretasi rasio harus mempertimbangkan industri, kebijakan akuntansi, musim usaha, dan periode pembanding.</p>`}
function openAccount(code){let a=db.coa.find(x=>x.code===code)||{code:'',name:'',type:'Asset',normal:'Debit',group:'',active:true};modalBox.innerHTML=`<div class="modalhead"><h3>${code?'Edit':'Tambah'} Akun</h3><button class="x" onclick="closeModal()">×</button></div><div class="form" style="margin-top:15px"><div class="field"><label>Kode</label><input id="aCode" value="${esc(a.code)}"></div><div class="field"><label>Nama</label><input id="aName" value="${esc(a.name)}"></div><div class="field"><label>Tipe</label><select id="aType"><option>Asset</option><option>Liability</option><option>Equity</option><option>Revenue</option><option>Expense</option></select></div><div class="field"><label>Saldo Normal</label><select id="aNormal"><option>Debit</option><option>Credit</option></select></div><div class="field"><label>Kategori / Kelompok</label><input id="aGroup" placeholder="Contoh: Aset Lancar"></div><div class="field"><label>Status Akun</label><select id="aActive"><option value="true">Aktif</option><option value="false">Nonaktif</option></select></div><button class="btn primary" onclick="saveAccount('${esc(code||'')}')">Simpan</button></div>`;aType.value=a.type;aNormal.value=a.normal;aGroup.value=a.group||'';aActive.value=String(a.active!==false);openModal()}
function saveAccount(old){let x={code:aCode.value.trim(),name:aName.value.trim(),type:aType.value,normal:aNormal.value,group:aGroup.value.trim(),active:aActive.value==='true'};if(!x.code||!x.name)return alert('Kode dan nama akun wajib diisi.');let i=db.coa.findIndex(a=>a.code===old);if(i>=0)db.coa[i]=x;else if(db.coa.some(a=>a.code===x.code))return alert('Kode akun sudah ada.');else db.coa.push(x);save();closeModal();renderAll()}
function deleteAccount(code){
 const used=db.journals.some(j=>j.lines.some(l=>l.account===code));
 if(used){
   if(confirm('Akun sudah digunakan dalam jurnal. Nonaktifkan akun ini agar tidak muncul pada transaksi baru?')){
     const a=db.coa.find(x=>x.code===code); if(a){a.active=false;save();renderAll();}
   }
   return;
 }
 if(confirm('Hapus akun ini secara permanen?')){db.coa=db.coa.filter(a=>a.code!==code);save();renderAll()}
}

function openAutoJournal(){
 let opts=accounts().map(a=>`<option value="${a.code}">${a.code} — ${esc(a.name)}</option>`).join('');
 modalBox.innerHTML=`<div class="modalhead"><h3>Jurnal Otomatis — Debit & Kredit</h3><button class="x" onclick="closeModal()">×</button></div>
 <div class="form" style="margin-top:15px">
 <div class="grid g3">
  <div class="field"><label>Tanggal</label><input id="ajDate" type="date" value="${new Date().toISOString().slice(0,10)}"></div>
  <div class="field"><label>No. Bukti</label><input id="ajNo" value="AUTO-${String(db.journals.length+1).padStart(5,'0')}"></div>
  <div class="field"><label>Jenis Transaksi</label><select id="ajType" onchange="autoJournalPreview()">
   <option value="sale_cash">Penerimaan/Pendapatan Tunai</option>
   <option value="sale_credit">Penerimaan/Pendapatan Kredit</option>
   <option value="purchase_cash">Pembelian Tunai</option>
   <option value="purchase_credit">Pembelian Kredit</option>
   <option value="expense_cash">Pembayaran Beban</option>
   <option value="receive_receivable">Penerimaan Piutang</option>
   <option value="pay_payable">Pembayaran Utang</option>
   <option value="capital_cash">Setoran Modal</option>
   <option value="withdrawal">Prive</option>
   <option value="loan_received">Penerimaan Pinjaman</option>
   <option value="loan_payment">Pembayaran Pinjaman</option>
   <option value="transfer">Transfer Kas/Bank</option>
   <option value="depreciation">Penyusutan</option>
  </select></div>
 </div>
 <div class="grid g2">
  <div class="field"><label>Nilai Transaksi</label><input id="ajAmount" type="number" min="0" step="0.01" value="0" oninput="autoJournalPreview()"></div>
  <div class="field"><label>Keterangan</label><input id="ajDesc" placeholder="Contoh: Penerimaan SPP/pendapatan pendidikan"></div>
 </div>
 <div class="grid g2">
  <div class="field"><label>Akun Utama</label><select id="ajMain" onchange="autoJournalPreview()">${opts}</select></div>
  <div class="field"><label>Akun Lawan</label><select id="ajContra" onchange="autoJournalPreview()">${opts}</select></div>
 </div>
 <div class="notice">Setiap transaksi yang disimpan langsung dibuat sebagai jurnal double-entry, masuk Buku Besar, Neraca Saldo, Laba Rugi/Neraca, dan Dashboard. Debit = Kredit wajib terpenuhi.</div>
 <div id="ajPreview" style="margin-top:14px"></div>
 <button class="btn primary" onclick="saveAutoJournal()">Simpan Jurnal Otomatis</button>
 </div>`;
 openModal(); autoJournalPreview();
}
function findCode(preferred, type, fallback){
 let a=accounts().find(x=>x.code===preferred)||accounts().find(x=>x.type===type && x.active);
 return a?a.code:(accounts()[0]?.code||fallback);
}
function autoJournalPreview(){
 if(!document.getElementById('ajType'))return;
 let type=ajType.value, amount=Number(ajAmount.value||0), main=ajMain.value, contra=ajContra.value;
 let debit=main, credit=contra, desc=ajDesc.value||'Jurnal otomatis';
 const pick=(type,code)=>{let a=accounts().find(x=>x.type===type&&x.code===code);return a?code:findCode('',type,code)};
 if(type==='sale_cash'){debit=findCode('1101','Asset',main);credit=findCode('4101','Revenue',contra);desc=ajDesc.value||'Penerimaan/pendapatan tunai'}
 if(type==='sale_credit'){debit=findCode('1103','Asset',main);credit=findCode('4101','Revenue',contra);desc=ajDesc.value||'Penerimaan/pendapatan kredit'}
 if(type==='purchase_cash'){debit=findCode('1104','Asset',main);credit=findCode('1101','Asset',contra);desc=ajDesc.value||'Pembelian tunai'}
 if(type==='purchase_credit'){debit=findCode('1104','Asset',main);credit=findCode('2101','Liability',contra);desc=ajDesc.value||'Pembelian kredit'}
 if(type==='expense_cash'){debit=findCode('', 'Expense', main);credit=findCode('1101','Asset',contra);desc=ajDesc.value||'Pembayaran beban'}
 if(type==='receive_receivable'){debit=findCode('1101','Asset',main);credit=findCode('1103','Asset',contra);desc=ajDesc.value||'Penerimaan piutang'}
 if(type==='pay_payable'){debit=findCode('2101','Liability',main);credit=findCode('1101','Asset',contra);desc=ajDesc.value||'Pembayaran utang'}
 if(type==='capital_cash'){debit=findCode('1101','Asset',main);credit=findCode('3101','Equity',contra);desc=ajDesc.value||'Setoran modal'}
 if(type==='withdrawal'){debit=findCode('3301','Equity',main);credit=findCode('1101','Asset',contra);desc=ajDesc.value||'Prive'}
 if(type==='loan_received'){debit=findCode('1101','Asset',main);credit=findCode('2201','Liability',contra);desc=ajDesc.value||'Penerimaan pinjaman'}
 if(type==='loan_payment'){debit=findCode('2201','Liability',main);credit=findCode('1101','Asset',contra);desc=ajDesc.value||'Pembayaran pinjaman'}
 if(type==='transfer'){debit=main;credit=contra;desc=ajDesc.value||'Transfer kas/bank'}
 if(type==='depreciation'){debit=findCode('5206','Expense',main);credit=findCode('1291','Asset',contra);desc=ajDesc.value||'Beban penyusutan'}
 document.getElementById('ajMain').value=debit;document.getElementById('ajContra').value=credit;
 document.getElementById('ajPreview').innerHTML=`<h4>Preview Jurnal</h4><table class="table"><thead><tr><th>Akun</th><th class="num">Debit</th><th class="num">Kredit</th></tr></thead><tbody>
 <tr><td>${debit} — ${esc(accounts().find(a=>a.code===debit)?.name||'')}</td><td class="num">${rupiah(amount)}</td><td></td></tr>
 <tr><td>${credit} — ${esc(accounts().find(a=>a.code===credit)?.name||'')}</td><td></td><td class="num">${rupiah(amount)}</td></tr>
 </tbody></table><p style="font-size:12px;color:#667085">Deskripsi: ${esc(desc)}</p>`;
 window.autoDraft={debit,credit,desc};
}
function saveAutoJournal(){
 let amount=Number(ajAmount.value||0); if(amount<=0)return alert('Nilai transaksi harus lebih besar dari 0.');
 autoJournalPreview(); let d=window.autoDraft;
 db.journals.push({id:'j'+Date.now(),date:ajDate.value,no:ajNo.value,desc:d.desc,lines:[
  {account:d.debit,note:'Debit otomatis',debit:amount,credit:0},
  {account:d.credit,note:'Kredit otomatis',debit:0,credit:amount}
 ]});
 save();closeModal();renderAll();
}
function openJournal(cashOnly=false){let j={id:'j'+Date.now(),date:new Date().toISOString().slice(0,10),no:'JV-'+String(db.journals.length+1).padStart(5,'0'),desc:'',lines:[{account:accounts()[0].code,debit:0,credit:0},{account:accounts()[1]?.code||accounts()[0].code,debit:0,credit:0}]};renderJournalForm(j,cashOnly)}
function editJournal(id){renderJournalForm(db.journals.find(j=>j.id===id))}
function renderJournalForm(j){modalBox.innerHTML=`<div class="modalhead"><h3>${j.id&&db.journals.some(x=>x.id===j.id)?'Edit':'Jurnal Baru'}</h3><button class="x" onclick="closeModal()">×</button></div><div class="form" style="margin-top:15px"><div class="grid g3"><div class="field"><label>Tanggal</label><input id="jDate" type="date" value="${j.date}"></div><div class="field"><label>No. Bukti</label><input id="jNo" value="${esc(j.no)}"></div><div class="field"><label>Deskripsi</label><input id="jDesc" value="${esc(j.desc)}"></div></div><div id="jLines"></div><button class="btn" onclick="addJLine()">+ Baris</button><div class="journal-total"><span>Total Debit: <b id="totD">0</b></span><span>Total Kredit: <b id="totC">0</b></span></div><button class="btn primary" onclick="saveJournal('${j.id}')">Simpan Jurnal</button></div>`;window.currentJournal=j;document.getElementById('jLines').innerHTML='';j.lines.forEach(addLine);updateTotals();openModal()}
function addLine(l={account:accounts()[0].code,debit:0,credit:0}){let row=document.createElement('div');row.className='jrow';row.innerHTML=`<select>${accounts().map(a=>`<option value="${a.code}">${a.code} — ${esc(a.name)}</option>`).join('')}</select><input placeholder="Catatan" value="${esc(l.note||'')}"><input type="number" min="0" step="0.01" value="${l.debit||0}"><input type="number" min="0" step="0.01" value="${l.credit||0}"><button class="btn danger" onclick="this.parentElement.remove();updateTotals()">×</button>`;row.children[0].value=l.account;row.querySelectorAll('input').forEach(x=>x.oninput=updateTotals);document.getElementById('jLines').appendChild(row)}
function addJLine(){addLine();updateTotals()}
function updateTotals(){let rows=[...document.querySelectorAll('#jLines .jrow')],d=rows.reduce((s,r)=>s+Number(r.children[2].value||0),0),c=rows.reduce((s,r)=>s+Number(r.children[3].value||0),0);document.getElementById('totD').textContent=rupiah(d);document.getElementById('totC').textContent=rupiah(c)}
function saveJournal(id){let rows=[...document.querySelectorAll('#jLines .jrow')],lines=rows.map(r=>({account:r.children[0].value,note:r.children[1].value,debit:Number(r.children[2].value||0),credit:Number(r.children[3].value||0)})).filter(x=>x.debit||x.credit);let d=lines.reduce((s,x)=>s+x.debit,0),c=lines.reduce((s,x)=>s+x.credit,0);if(!jDate.value||!jNo.value||!jDesc.value||lines.length<2)return alert('Lengkapi jurnal minimal 2 baris.');if(Math.abs(d-c)>0.01)return alert('Jurnal tidak seimbang: debit harus sama dengan kredit.');let j={id:id||'j'+Date.now(),date:jDate.value,no:jNo.value,desc:jDesc.value,lines};let i=db.journals.findIndex(x=>x.id===id);if(i>=0)db.journals[i]=j;else db.journals.push(j);save();closeModal();renderAll()}
function deleteJournal(id){if(confirm('Hapus jurnal ini?')){db.journals=db.journals.filter(j=>j.id!==id);save();renderAll()}}
function openModal(){document.getElementById('modal').classList.add('open')}function closeModal(){document.getElementById('modal').classList.remove('open')}
function saveSettings(){db.settings.name=setName.value||'AL BAYAN HIDAYATULLAH MAKASSAR';db.settings.period=setPeriod.value||period();db.settings.standard=setStandard.value;save();renderAll();alert('Pengaturan disimpan.')}
function exportData(){let blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='finpro-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href)}
document.getElementById('importFile').onchange=e=>{let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result);if(!x.coa||!x.journals)throw 0;db=x;save();renderAll();alert('Data berhasil diimpor.')}catch{alert('File backup tidak valid.')}};r.readAsText(f)}
function resetData(){if(confirm('PERINGATAN: seluruh COA, jurnal dan pengaturan akan dihapus. Lanjutkan?')){localStorage.removeItem(KEY);location.reload()}}
function renderAll(){ensureUsers();renderDashboard();renderEvaluation();renderJournal();renderLedger();renderCash();renderReports();renderCOA();renderBudgetPage();renderDashboardBudget();renderCentral();setName.value=db.settings.name;setPeriod.value=db.settings.period;setStandard.value=db.settings.standard;if(db.session&&db.session.loggedIn){document.getElementById('loginScreen').style.display='none';currentUser.textContent=db.session.username}else{document.getElementById('loginScreen').style.display='flex'}}
renderAll();
</script>

<script>
/* AL BAYAN HIDAYATULLAH MAKASSAR — Accounting Integrity Layer
   - Normalizes legacy data
   - Prevents posting to header/group accounts
   - Enforces double-entry balance
   - Keeps reports derived from journal lines
*/
(function(){
  const ROOT_KEY = 'finpro_accounting_v1';

  function accType(a){ return String(a?.type||'').trim(); }
  function isHeader(a){
    if(!a) return true;
    const g = String(a.group||'').toLowerCase();
    const code = String(a.code||'');
    return a.postable === false || /^(1000|1100|1200|1300|2000|2100|2200|3000|4000|5000)$/.test(code) ||
           ['header','group','subgroup'].includes(g);
  }
  function normalBalance(a){
    const t=accType(a);
    return ['Asset','Expense'].includes(t) ? 'Debit' : 'Credit';
  }
  function amount(v){
    const n=Number(v);
    return Number.isFinite(n) ? Math.round(n*100)/100 : 0;
  }
  function getDB(){
    try { return JSON.parse(localStorage.getItem(ROOT_KEY)||'null'); } catch(e){ return null; }
  }
  function putDB(db){ localStorage.setItem(ROOT_KEY, JSON.stringify(db)); }

  window.ABYAN = window.ABYAN || {};
  ABYAN.accounting = {
    isHeader, normalBalance, amount,
    validate(db){
      const errors=[];
      const coa=Array.isArray(db.coa)?db.coa:[];
      const byCode=new Map();
      coa.forEach(a=>{
        const c=String(a.code||'').trim();
        if(!c) errors.push('Ada akun tanpa kode.');
        else if(byCode.has(c)) errors.push('Kode akun ganda: '+c);
        else byCode.set(c,a);
        if(!a.name) errors.push('Akun '+c+' belum memiliki nama.');
      });
      (db.journals||[]).forEach((j,i)=>{
        const lines=Array.isArray(j.lines)?j.lines:[];
        let d=0,c=0;
        lines.forEach(l=>{
          const a=byCode.get(String(l.account||l.code||''));
          const v=amount(l.amount);
          if(!a) errors.push('Jurnal '+(j.id||i+1)+' memakai akun yang tidak ada.');
          else if(isHeader(a)) errors.push('Jurnal '+(j.id||i+1)+' memakai akun header/non-posting: '+a.code);
          if(v<0) errors.push('Jurnal '+(j.id||i+1)+' memiliki nilai negatif.');
          if(String(l.dc||l.side||'').toUpperCase()==='D') d+=v;
          if(String(l.dc||l.side||'').toUpperCase()==='C') c+=v;
        });
        if(lines.length && Math.abs(d-c)>0.005) errors.push('Jurnal '+(j.id||i+1)+' tidak balance.');
      });
      return errors;
    },
    migrate(db){
      if(!db || !Array.isArray(db.coa)) return db;
      db.coa.forEach(a=>{
        a.code=String(a.code||'').trim();
        a.name=String(a.name||'').trim();
        a.type=accType(a);
        a.normal= a.normal || normalBalance(a);
        a.postable = a.postable !== false && !isHeader(a);
      });
      // Mark journals' account references consistently.
      (db.journals||[]).forEach(j=>{
        (j.lines||[]).forEach(l=>{
          if(l.account==null && l.code!=null) l.account=l.code;
          l.account=String(l.account||'').trim();
          l.dc=(String(l.dc||l.side||'').toUpperCase()==='C')?'C':'D';
          l.amount=amount(l.amount);
        });
      });
      return db;
    },
    save(db){
      db=this.migrate(db);
      putDB(db);
      return db;
    }
  };

  // Make the default COA explicitly posting-aware.
  const db=getDB();
  if(db){
    ABYAN.accounting.save(db);
  }
})();
</script>


<script>
(function(){
  const K='finpro_accounting_v1';
  function load(){return JSON.parse(localStorage.getItem(K)||'null');}
  function save(db){localStorage.setItem(K,JSON.stringify(db));}
  function val(x){const n=Number(x);return Number.isFinite(n)?Math.round(n*100)/100:0;}
  window.ABYAN_POST = function(date, desc, lines, meta){
    const db=load();
    if(!db) throw new Error('Database belum tersedia.');
    const coa=new Map((db.coa||[]).map(a=>[String(a.code),a]));
    let debit=0, credit=0;
    const normalized=(lines||[]).map(x=>{
      const code=String(x.account||x.code||'').trim();
      const a=coa.get(code);
      if(!a) throw new Error('Akun '+code+' tidak ditemukan.');
      if(a.postable===false || ABYAN.accounting.isHeader(a))
        throw new Error('Akun '+code+' adalah akun kelompok/header dan tidak boleh dipakai untuk jurnal.');
      const n=val(x.amount);
      if(n<=0) throw new Error('Nilai jurnal harus lebih dari 0.');
      const dc=String(x.dc||x.side||'').toUpperCase()==='C'?'C':'D';
      if(dc==='D') debit+=n; else credit+=n;
      return {account:code,dc,amount:n};
    });
    if(!normalized.length) throw new Error('Jurnal tidak memiliki baris.');
    if(Math.abs(debit-credit)>0.005)
      throw new Error('Jurnal tidak balance. Debit Rp '+debit.toLocaleString('id-ID')+' ≠ Kredit Rp '+credit.toLocaleString('id-ID')+'.');
    const j={
      id:'JRN-'+Date.now(),
      date:date||new Date().toISOString().slice(0,10),
      desc:String(desc||'Transaksi'),
      lines:normalized,
      meta:meta||{}
    };
    db.journals=db.journals||[];
    db.journals.push(j);
    save(db);
    return j;
  };
})();
</script>


<script>
function runAccountingIntegrityCheck(){
  try{
    const db=JSON.parse(localStorage.getItem('finpro_accounting_v1')||'null');
    if(!db){alert('Database belum tersedia.');return;}
    const errs=window.ABYAN?.accounting?.validate(db)||[];
    if(!errs.length){
      alert('✓ PEMERIKSAAN BERHASIL\\n\\nCOA, jurnal debit/kredit, dan relasi akun tidak ditemukan error.');
    }else{
      alert('⚠ DITEMUKAN '+errs.length+' MASALAH\\n\\n'+errs.slice(0,25).join('\\n'));
    }
  }catch(e){alert('Pemeriksaan gagal: '+e.message);}
}
</script>


<script id="abyan-v6-fix">
(function(){
  const KEY='finpro_accounting_v1';
  const HEADER_CODES=new Set(['1000','1100','1200','1300','2000','2100','2200','3000','4000','5000']);
  const TYPES=['Asset','Liability','Equity','Revenue','Expense'];
  const NORMAL=['Debit','Credit'];
  const today=()=>new Date().toISOString().slice(0,10);
  const read=()=>{try{return JSON.parse(localStorage.getItem(KEY)||'null')}catch(e){return null}};
  const write=db=>localStorage.setItem(KEY,JSON.stringify(db));
  function normalizeDB(db){
    db=db||{}; db.settings=db.settings||{name:'AL BAYAN HIDAYATULLAH MAKASSAR',period:new Date().toISOString().slice(0,7),standard:'SAK Entitas Privat (EP)'};
    db.coa=Array.isArray(db.coa)?db.coa:[]; db.journals=Array.isArray(db.journals)?db.journals:[];
    db.coa.forEach(a=>{a.code=String(a.code||'').trim();a.name=String(a.name||'').trim();a.type=TYPES.includes(a.type)?a.type:'Asset';a.normal=NORMAL.includes(a.normal)?a.normal:(['Asset','Expense'].includes(a.type)?'Debit':'Credit');a.group=String(a.group||'').trim();a.active=a.active!==false;
      if(a.postable===undefined) a.postable=!HEADER_CODES.has(a.code) && !['header','group','subgroup'].includes(a.group.toLowerCase());
    });
    db.journals.forEach((j,i)=>{j.id=String(j.id||'JRN-'+(i+1));j.date=String(j.date||today());j.no=String(j.no||('JV-'+String(i+1).padStart(5,'0')));j.desc=String(j.desc||'');j.lines=Array.isArray(j.lines)?j.lines:[];
      j.lines.forEach(l=>{l.account=String(l.account||l.code||'').trim();
        let d=Number(l.debit),c=Number(l.credit),amt=Number(l.amount);
        if(!Number.isFinite(d)) d=0;if(!Number.isFinite(c)) c=0;if(!Number.isFinite(amt)) amt=0;
        if((d===0&&c===0)&&amt>0){ if(String(l.dc||l.side||'').toUpperCase()==='C') c=amt; else d=amt; }
        l.debit=Math.max(0,d);l.credit=Math.max(0,c);l.amount=l.debit||l.credit||0;l.dc=l.debit>0&&l.credit===0?'D':(l.credit>0&&l.debit===0?'C':String(l.dc||'D').toUpperCase()==='C'?'C':'D');
      });
    });
    if(!db.users)db.users=[{username:'admin',password:'admin123',role:'Administrator',active:true}];
    if(!db.session)db.session={loggedIn:false,username:''};
    return db;
  }
  let DB=normalizeDB(read()); if(DB){write(DB); window.db=DB;}
  // Keep header/posting logic user-editable rather than hard-coded forever.
  if(window.ABYAN&&ABYAN.accounting){ABYAN.accounting.isHeader=function(a){if(!a)return true;return a.postable===false||['header','group','subgroup'].includes(String(a.group||'').toLowerCase())};}
  window.save=function(){DB=normalizeDB(window.db||read());write(DB);window.db=DB};
  window.accounts=function(){return (window.db.coa||[]).filter(a=>a.active!==false&&a.postable!==false).map(a=>({...a,group:a.group||''}));};

  function usedCodes(){const m={};(db.journals||[]).forEach(j=>(j.lines||[]).forEach(l=>{const c=String(l.account||'');if(c)m[c]=(m[c]||0)+1}));return m;}
  function openAccountV6(code){
    const a=(db.coa||[]).find(x=>x.code===code)||{code:'',name:'',type:'Asset',normal:'Debit',group:'',active:true,postable:true};
    const used=usedCodes()[a.code]||0;
    modalBox.innerHTML=`<div class="modalhead"><h3>${code?'Edit':'Tambah'} Akun</h3><button class="x" onclick="closeModal()">×</button></div>
    <div class="form" style="margin-top:15px"><div class="grid g2">
    <div class="field"><label>Kode Akun</label><input id="aCode" value="${esc(a.code)}" placeholder="Contoh: 1101"></div>
    <div class="field"><label>Nama Akun</label><input id="aName" value="${esc(a.name)}"></div>
    <div class="field"><label>Tipe</label><select id="aType">${TYPES.map(x=>`<option>${x}</option>`).join('')}</select></div>
    <div class="field"><label>Saldo Normal</label><select id="aNormal"><option>Debit</option><option>Credit</option></select></div>
    <div class="field"><label>Kategori / Kelompok</label><input id="aGroup" value="${esc(a.group||'')}" placeholder="Contoh: Aset Lancar"></div>
    <div class="field"><label>Status</label><select id="aActive"><option value="true">Aktif</option><option value="false">Nonaktif</option></select></div>
    <div class="field"><label>Status Posting</label><select id="aPostable"><option value="true">Bisa diposting</option><option value="false">Header / tidak diposting</option></select></div>
    <div class="field"><label>Riwayat Transaksi</label><input value="${used} jurnal" disabled></div>
    </div><div class="notice">Kode akun boleh diubah. Jika akun sudah dipakai, seluruh referensi jurnal akan dipindahkan otomatis ke kode baru agar histori tetap utuh.</div>
    <button class="btn primary" onclick="saveAccount('${esc(code||'')}')">Simpan Akun</button></div>`;
    aType.value=a.type;aNormal.value=a.normal;aGroup.value=a.group||'';aActive.value=String(a.active!==false);aPostable.value=String(a.postable!==false);openModal();
  }
  window.openAccount=openAccountV6;
  window.saveAccount=function(oldCode){
    const x={code:aCode.value.trim(),name:aName.value.trim(),type:aType.value,normal:aNormal.value,group:aGroup.value.trim(),active:aActive.value==='true',postable:aPostable.value==='true'};
    if(!x.code||!x.name)return alert('Kode dan nama akun wajib diisi.');
    if(!TYPES.includes(x.type)||!NORMAL.includes(x.normal))return alert('Tipe atau saldo normal tidak valid.');
    const duplicate=db.coa.some(a=>a.code===x.code&&a.code!==oldCode);if(duplicate)return alert('Kode akun sudah digunakan.');
    const idx=db.coa.findIndex(a=>a.code===oldCode);
    if(idx>=0){
      db.coa[idx]={...db.coa[idx],...x};
      if(oldCode!==x.code){(db.journals||[]).forEach(j=>(j.lines||[]).forEach(l=>{if(String(l.account)===oldCode)l.account=x.code;}));}
    }else db.coa.push(x);
    save();closeModal();renderAll();alert('Akun berhasil disimpan.');
  };
  window.deleteAccount=function(code){
    const a=db.coa.find(x=>x.code===code);if(!a)return;
    const used=usedCodes()[code]||0;
    if(used){
      const choices=accounts().filter(x=>x.code!==code);
      if(!choices.length)return alert('Tidak ada akun pengganti.');
      modalBox.innerHTML=`<div class="modalhead"><h3>Hapus Akun yang Sudah Dipakai</h3><button class="x" onclick="closeModal()">×</button></div><div class="form"><p>Akun <b>${esc(code)} — ${esc(a.name)}</b> dipakai pada <b>${used}</b> jurnal. Pilih akun pengganti agar histori tetap utuh.</p><div class="field"><label>Alihkan seluruh transaksi ke</label><select id="deleteReplacement">${choices.map(x=>`<option value="${x.code}">${x.code} — ${esc(x.name)}</option>`).join('')}</select></div><button class="btn danger" onclick="confirmDeleteUsedAccount('${esc(code)}')">Alihkan & Hapus</button></div>`;openModal();return;
    }
    if(confirm('Hapus akun '+code+' secara permanen?')){db.coa=db.coa.filter(x=>x.code!==code);save();renderAll();}
  };
  window.confirmDeleteUsedAccount=function(code){const repl=deleteReplacement.value;if(!repl||repl===code)return alert('Pilih akun pengganti yang valid.');if(!confirm('Semua transaksi akun ini akan dialihkan ke '+repl+'. Lanjutkan?'))return;(db.journals||[]).forEach(j=>(j.lines||[]).forEach(l=>{if(String(l.account)===code)l.account=repl;}));db.coa=db.coa.filter(a=>a.code!==code);save();closeModal();renderAll();alert('Akun dihapus dan seluruh histori dialihkan dengan aman.');};

  function coaRows(){const q=(document.getElementById('coaSearch')?.value||'').toLowerCase(),ty=document.getElementById('coaType')?.value||'',u=usedCodes();return db.coa.filter(a=>(!q||(a.code+' '+a.name+' '+(a.group||'')).toLowerCase().includes(q))&&(!ty||a.type===ty)).sort((a,b)=>a.code.localeCompare(b.code));}
  window.renderCOA=function(){const arr=coaRows();const el=document.getElementById('coaTable');if(!el)return;el.innerHTML=`<div class="tablewrap"><table class="table"><thead><tr><th>Kode</th><th>Nama Akun</th><th>Kelompok</th><th>Tipe</th><th>Normal</th><th>Posting</th><th>Status</th><th>Dipakai</th><th>Aksi</th></tr></thead><tbody>${arr.map(a=>`<tr><td><b>${esc(a.code)}</b></td><td>${esc(a.name)}</td><td>${esc(a.group||'')}</td><td>${a.type}</td><td>${a.normal}</td><td>${a.postable!==false?'<span class="pill good">Posting</span>':'<span class="pill warn">Header</span>'}</td><td>${a.active!==false?'<span class="pill good">Aktif</span>':'<span class="pill bad">Nonaktif</span>'}</td><td>${u[a.code]||0} jurnal</td><td><button class="btn" onclick="openAccount('${esc(a.code)}')">Edit</button> <button class="btn danger" onclick="deleteAccount('${esc(a.code)}')">Hapus</button> <button class="btn" onclick="exportOneAccount('${esc(a.code)}')">Ekspor</button></td></tr>`).join('')||'<tr><td colspan="9" class="empty">Belum ada akun.</td></tr>'}</tbody></table></div>`;};

  function download(name,text,type){const blob=new Blob([text],{type});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),500);}
  window.exportOneAccount=function(code){const a=db.coa.find(x=>x.code===code);if(!a)return;const out={exportedAt:new Date().toISOString(),account:{...a},usage:{journalCount:usedCodes()[code]||0},relatedJournals:(db.journals||[]).filter(j=>(j.lines||[]).some(l=>String(l.account)===code))};download('akun-'+code+'-'+today()+'.json',JSON.stringify(out,null,2),'application/json');};
  window.exportCOAJSON=function(){download('COA-detail-'+today()+'.json',JSON.stringify({version:6,exportedAt:new Date().toISOString(),coa:db.coa},null,2),'application/json');};
  function csvCell(v){v=String(v??'');return '"'+v.replace(/"/g,'""')+'"';}
  window.exportCOACSV=function(){const rows=[['code','name','type','normal','group','active','postable'],...db.coa.map(a=>[a.code,a.name,a.type,a.normal,a.group||'',a.active!==false,a.postable!==false])];download('COA-bulk-'+today()+'.csv',rows.map(r=>r.map(csvCell).join(',')).join('\n'),'text/csv;charset=utf-8');};
  window.downloadCOATemplate=function(){const rows=[['code','name','type','normal','group','active','postable'],['6101','Contoh Akun','Expense','Debit','Beban Operasional','true','true']];download('template-import-COA.csv',rows.map(r=>r.map(csvCell).join(',')).join('\n'),'text/csv;charset=utf-8');};
  function parseCSV(text){const rows=[];let row=[],cell='',q=false;for(let i=0;i<text.length;i++){const ch=text[i],nx=text[i+1];if(ch==='"'&&q&&nx==='"'){cell+='"';i++;continue}if(ch==='"'){q=!q;continue}if((ch===','||ch===';')&&!q){row.push(cell);cell='';continue}if((ch==='\n'||ch==='\r')&&!q){if(ch==='\r'&&nx==='\n')i++;row.push(cell);if(row.some(x=>x.trim()!==''))rows.push(row);row=[];cell='';continue}cell+=ch;}if(cell!==''||row.length){row.push(cell);if(row.some(x=>x.trim()!==''))rows.push(row);}return rows;}
  function importCOARows(rows,mode){if(!rows.length)return 0;let head=rows[0].map(x=>String(x).trim().toLowerCase());if(head[0]!=='code')rows.unshift(['code','name','type','normal','group','active','postable']);head=rows[0].map(x=>String(x).trim().toLowerCase());let n=0;for(let i=1;i<rows.length;i++){const r=rows[i];const o={};head.forEach((h,k)=>o[h]=String(r[k]??'').trim());if(!o.code||!o.name)continue;o.type=TYPES.includes(o.type)?o.type:'Asset';o.normal=NORMAL.includes(o.normal)?o.normal:(['Asset','Expense'].includes(o.type)?'Debit':'Credit');o.group=o.group||'';o.active=o.active.toLowerCase()!=='false';o.postable=o.postable===''?!HEADER_CODES.has(o.code):o.postable.toLowerCase()!=='false';const idx=db.coa.findIndex(a=>a.code===o.code);if(idx>=0){db.coa[idx]={...db.coa[idx],...o};}else db.coa.push(o);n++;}return n;}
  document.getElementById('coaImportFile').onchange=function(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const text=r.result;if(f.name.toLowerCase().endsWith('.json')){const x=JSON.parse(text);const arr=Array.isArray(x)?x:(x.coa||[x.account]).filter(Boolean);if(!arr.length)throw new Error('Tidak ada data akun');let n=0;arr.forEach(o=>{if(!o.code||!o.name)return;const idx=db.coa.findIndex(a=>a.code===String(o.code));const item={code:String(o.code),name:String(o.name),type:TYPES.includes(o.type)?o.type:'Asset',normal:NORMAL.includes(o.normal)?o.normal:'Debit',group:String(o.group||''),active:o.active!==false,postable:o.postable!==false};if(idx>=0)db.coa[idx]={...db.coa[idx],...item};else db.coa.push(item);n++;});save();renderAll();alert(n+' akun berhasil diimpor/diperbarui.');}else{const rows=parseCSV(text);const n=importCOARows(rows,'merge');save();renderAll();alert(n+' akun berhasil diimpor/diperbarui secara massal.');}}catch(err){alert('Import gagal: '+err.message)}e.target.value='';};r.readAsText(f);};

  // Full backup is versioned and safely merges missing structural fields on import.
  window.exportData=function(){DB=normalizeDB(read());download('AL_BAYAN_FULL_BACKUP-'+today()+'.json',JSON.stringify({...DB,backupVersion:6,exportedAt:new Date().toISOString()},null,2),'application/json');};
  document.getElementById('importFile').onchange=function(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const x=normalizeDB(JSON.parse(r.result));if(!Array.isArray(x.coa)||!Array.isArray(x.journals))throw new Error('Format backup tidak lengkap.');if(!confirm('Import backup akan mengganti data saat ini. Buat Export dulu jika ingin cadangan. Lanjutkan?'))return;window.db=x;save();renderAll();alert('Backup berhasil dipulihkan.');}catch(err){alert('Import backup gagal: '+err.message)}e.target.value='';};r.readAsText(f);};

  function renderCentral(){const el=document.getElementById('centralInfoGrid');if(!el)return;const u=usedCodes(),active=db.coa.filter(a=>a.active!==false).length,post=db.coa.filter(a=>a.active!==false&&a.postable!==false).length,headers=db.coa.filter(a=>a.postable===false).length,used=Object.keys(u).length,budget=(db.budgets||[]).reduce((s,b)=>s+Number(b.amount||b.budget||0),0),journals=db.journals.length;const errs=(window.ABYAN?.accounting?.validate?ABYAN.accounting.validate(db):[]);el.innerHTML=`<div class="central-stat"><span>AKUN AKTIF</span><b>${num(active)}</b><small>${num(post)} akun posting</small></div><div class="central-stat"><span>AKUN HEADER</span><b>${num(headers)}</b><small>${num(used)} akun sudah dipakai</small></div><div class="central-stat"><span>JURNAL</span><b>${num(journals)}</b><small>double-entry tercatat</small></div><div class="central-stat"><span>ANGGARAN</span><b>${rupiah(budget)}</b><small>${num((db.budgets||[]).length)} item</small></div><div class="central-stat"><span>DATA</span><b>LOCAL</b><small>tersimpan di perangkat</small></div><div class="central-stat"><span>INTEGRITAS</span><b>${errs.length?'PERIKSA':'OK'}</b><small>${errs.length?num(errs.length)+' temuan':'COA & jurnal tervalidasi'}</small></div>`;const badge=document.getElementById('systemHealthBadge');if(badge){badge.textContent=errs.length?'PERIKSA':'SIAP';badge.className='mini-badge';if(errs.length)badge.style.color='#b42318';}}
  const oldRenderDashboard=window.renderDashboard;
  window.renderDashboard=function(){try{oldRenderDashboard();}catch(e){console.warn('Dashboard utama:',e)}renderCentral();};
  const oldRenderAll=window.renderAll;
  window.renderAll=function(){DB=normalizeDB(window.db||read());window.db=DB;write(DB);try{oldRenderAll();}catch(e){console.warn('Render legacy:',e)}try{renderCentral();}catch(e){}try{renderCOA();}catch(e){}};
  const oldShowPage=window.showPage;
  window.showPage=function(p){const labels={dashboard:'Dashboard',evaluation:'Evaluasi & Rasio',journal:'Jurnal Umum',ledger:'Buku Besar',cash:'Kas & Bank',trial:'Neraca Saldo',income:'Laba Rugi',balance:'Neraca',cashflow:'Arus Kas',equity:'Perubahan Ekuitas',budget:'Anggaran vs Realisasi',coa:'COA / Akun',settings:'Pengaturan'};document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));const page=document.getElementById(p);if(page)page.classList.add('active');document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===p));document.getElementById('pageTitle').textContent=labels[p]||p;try{renderAll();}catch(e){console.error(e)}};
  document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>showPage(b.dataset.page));
  // Fix initial budget page access and keep all data visible.
  window.runAccountingIntegrityCheck=function(){const errs=ABYAN?.accounting?.validate?ABYAN.accounting.validate(db):[];if(!errs.length)alert('✓ SISTEM TERVALIDASI\n\nCOA, jurnal, dan struktur data siap digunakan.');else alert('⚠ DITEMUKAN '+errs.length+' TEMUAN\n\n'+errs.slice(0,30).join('\n'));};
  setTimeout(()=>{try{renderAll();}catch(e){console.error('Final render error',e)}},0);
})();
</script>
<script id="asset-management-v1">
(function(){
  const KEY='finpro_accounting_v1';
  const today=()=>new Date().toISOString().slice(0,10);
  const money=n=>typeof rupiah==='function'?rupiah(n):new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(n||0);
  const safeNum=v=>{const n=Number(v);return Number.isFinite(n)?n:0};
  const escA=v=>typeof esc==='function'?esc(v):String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  function ensure(){
    db.assets=Array.isArray(db.assets)?db.assets:[];
    db.assets.forEach((a,i)=>{
      a.id=String(a.id||('AST-'+Date.now()+'-'+i));
      a.code=String(a.code||('AST-'+String(i+1).padStart(4,'0')));
      a.name=String(a.name||'Aset Tetap'); a.category=String(a.category||'Peralatan Kantor'); a.location=String(a.location||''); a.responsible=String(a.responsible||'');
      a.acquisitionDate=String(a.acquisitionDate||a.date||today()); a.availableDate=String(a.availableDate||a.acquisitionDate); a.cost=Math.max(0,safeNum(a.cost??a.amount)); a.residual=Math.max(0,safeNum(a.residual));
      a.usefulYears=Math.max(.01,safeNum(a.usefulYears||5)); a.method=['SL','DB','UOP'].includes(a.method)?a.method:'SL'; a.unitsTotal=Math.max(0,safeNum(a.unitsTotal)); a.unitsUsed=Math.max(0,safeNum(a.unitsUsed));
      a.assetAccount=String(a.assetAccount||defaultAssetAccount(a.category)); a.accumAccount=String(a.accumAccount||defaultAccumAccount(a.category)); a.expenseAccount=String(a.expenseAccount||'5206'); a.sourceAccount=String(a.sourceAccount||'1102');
      a.status=['Aktif','Dilepas','Fully Depreciated'].includes(a.status)?a.status:'Aktif'; a.notes=String(a.notes||'');
    });
    return db.assets;
  }
  function defaultAssetAccount(cat){const c=String(cat).toLowerCase(); if(c.includes('bangun'))return '1202';if(c.includes('kendaraan'))return '1203';if(c.includes('mesin'))return '1205';if(c.includes('peralatan'))return '1204';return '1204';}
  function defaultAccumAccount(cat){const c=String(cat).toLowerCase(); if(c.includes('bangun'))return '1291';if(c.includes('kendaraan'))return '1292';if(c.includes('mesin'))return '1294';return '1293';}
  function saveA(){if(typeof saveDB==='function')saveDB();else if(typeof save==='function')save();else localStorage.setItem(KEY,JSON.stringify(db));}
  function coaPostable(){return (db.coa||[]).filter(a=>a.active!==false&&a.postable!==false&&!ABYAN.accounting.isHeader(a));}
  function options(type,selected){return coaPostable().filter(a=>!type||a.type===type).map(a=>`<option value="${escA(a.code)}" ${a.code===selected?'selected':''}>${escA(a.code)} — ${escA(a.name)}</option>`).join('');}
  function monthsBetween(start,end){const s=new Date(start+'T00:00:00'),e=new Date(end+'T00:00:00');return Math.max(0,(e.getFullYear()-s.getFullYear())*12+e.getMonth()-s.getMonth()+1);}
  function depToDate(a,to){
    if(a.status==='Dilepas') return 0;
    const start=new Date((a.availableDate||a.acquisitionDate)+'T00:00:00'), end=new Date(to+'T00:00:00'); if(end<start)return 0;
    const depreciable=Math.max(0,a.cost-a.residual), lifeMonths=Math.max(1,Math.round(a.usefulYears*12)), elapsed=Math.min(lifeMonths,monthsBetween(a.availableDate||a.acquisitionDate,to));
    if(a.method==='DB'){
      const rate=2/lifeMonths; let nbv=a.cost, total=0; for(let m=1;m<=elapsed;m++){const d=Math.min(Math.max(0,nbv-a.residual),nbv*rate);total+=d;nbv-=d;if(nbv<=a.residual+0.005)break;} return Math.min(depreciable,total);
    }
    if(a.method==='UOP'){if(a.unitsTotal<=0)return 0;return Math.min(depreciable,depreciable*(Math.min(a.unitsUsed,a.unitsTotal)/a.unitsTotal));}
    return Math.min(depreciable,depreciable*(elapsed/lifeMonths));
  }
  function periodEnd(){const p=(db.settings&&db.settings.period)||new Date().toISOString().slice(0,7);return p+'-'+new Date(Number(p.slice(0,4)),Number(p.slice(5,7)),0).getDate();}
  function postedDep(a,period){return (db.journals||[]).filter(j=>j.meta&&j.meta.assetId===a.id&&j.meta.kind==='depreciation'&&j.meta.period===period).reduce((s,j)=>s+(j.lines||[]).filter(l=>String(l.account)===a.expenseAccount&&String(l.dc).toUpperCase()==='D').reduce((x,l)=>x+safeNum(l.amount),0),0);}
  function accumulatedFromJournals(a){return (db.journals||[]).filter(j=>j.meta&&j.meta.assetId===a.id&&j.meta.kind==='depreciation').reduce((s,j)=>s+(j.lines||[]).filter(l=>String(l.account)===a.accumAccount&&String(l.dc).toUpperCase()==='C').reduce((x,l)=>x+safeNum(l.amount),0),0);}
  function assetState(a){const accumulated=Math.min(Math.max(0, a.cost-a.residual), Math.max(0, accumulatedFromJournals(a))); const book=Math.max(a.residual,a.cost-accumulated); const plan=depToDate(a,periodEnd()); return {accumulated,book,plan,period:postedDep(a,(db.settings&&db.settings.period)||'')};}
  window.openAssetForm=function(id){
    ensure(); const a=db.assets.find(x=>x.id===id)||{id:'',code:'',name:'',category:'Peralatan Kantor',location:'',responsible:'',acquisitionDate:today(),availableDate:today(),cost:0,residual:0,usefulYears:5,method:'SL',unitsTotal:0,unitsUsed:0,assetAccount:'1204',accumAccount:'1293',expenseAccount:'5206',sourceAccount:'1102',status:'Aktif',notes:''};
    const editing=!!id;
    modalBox.innerHTML=`<div class="modalhead"><h3>${editing?'Edit':'Tambah'} Aset Tetap</h3><button class="x" onclick="closeModal()">×</button></div><div class="asset-form-grid form" style="margin-top:15px">
      <div class="field"><label>Kode Aset</label><input id="astCode" value="${escA(a.code)}" placeholder="AST-0001"></div>
      <div class="field"><label>Nama Aset</label><input id="astName" value="${escA(a.name)}"></div>
      <div class="field"><label>Kategori</label><select id="astCat"><option>Tanah</option><option>Bangunan</option><option>Kendaraan</option><option>Peralatan Kantor</option><option>Mesin</option><option>Peralatan Lainnya</option></select></div>
      <div class="field"><label>Status</label><select id="astStatus"><option>Aktif</option><option>Dilepas</option><option>Fully Depreciated</option></select></div>
      <div class="field"><label>Tanggal Perolehan</label><input id="astAcq" type="date" value="${escA(a.acquisitionDate)}"></div>
      <div class="field"><label>Tersedia Untuk Digunakan</label><input id="astAvail" type="date" value="${escA(a.availableDate)}"></div>
      <div class="field"><label>Nilai Perolehan</label><input id="astCost" type="number" min="0" step="0.01" value="${a.cost}"></div>
      <div class="field"><label>Nilai Residu</label><input id="astResidual" type="number" min="0" step="0.01" value="${a.residual}"></div>
      <div class="field"><label>Umur Manfaat (tahun)</label><input id="astLife" type="number" min="0.01" step="0.01" value="${a.usefulYears}"></div>
      <div class="field"><label>Metode Penyusutan</label><select id="astMethod"><option value="SL">Garis Lurus</option><option value="DB">Saldo Menurun</option><option value="UOP">Unit Produksi</option></select></div>
      <div class="field"><label>Total Unit Produksi</label><input id="astUnitsTotal" type="number" min="0" step="1" value="${a.unitsTotal}"></div>
      <div class="field"><label>Unit Produksi Terpakai Kumulatif</label><input id="astUnitsUsed" type="number" min="0" step="1" value="${a.unitsUsed}"></div>
      <div class="field"><label>Akun Aset</label><select id="astAssetAccount">${options('Asset',a.assetAccount)}</select></div>
      <div class="field"><label>Akumulasi Penyusutan</label><select id="astAccumAccount">${options('Asset',a.accumAccount)}</select></div>
      <div class="field"><label>Beban Penyusutan</label><select id="astExpenseAccount">${options('Expense',a.expenseAccount)}</select></div>
      <div class="field"><label>Sumber Perolehan (Kas/Bank/Utang)</label><select id="astSourceAccount">${options('',a.sourceAccount)}</select></div>
      <div class="field"><label>Lokasi</label><input id="astLocation" value="${escA(a.location)}"></div>
      <div class="field"><label>Penanggung Jawab</label><input id="astResponsible" value="${escA(a.responsible)}"></div>
      <div class="field full"><label>Catatan</label><textarea id="astNotes" rows="3">${escA(a.notes)}</textarea></div>
      <div class="field full asset-policy"><b>Kebijakan:</b> sistem memakai biaya perolehan sebagai dasar, mengurangi akumulasi penyusutan, dan memulai penyusutan saat aset tersedia untuk digunakan. Perubahan umur manfaat, nilai residu, atau metode setelah perubahan estimasi harus didokumentasikan.</div>
      <div class="field full"><button class="btn primary" onclick="saveAsset('${escA(a.id)}')">Simpan Master Aset</button>${!editing?` <button class="btn good" onclick="saveAsset('${escA(a.id)}',true)">Simpan + Catat Perolehan</button>`:''}</div>
    </div>`;
    astCat.value=a.category;astStatus.value=a.status;astMethod.value=a.method;openModal();
  };
  window.saveAsset=function(id,postAcq){
    ensure(); const code=astCode.value.trim(),name=astName.value.trim(),cost=safeNum(astCost.value),res=safeNum(astResidual.value),life=safeNum(astLife.value);
    if(!code||!name)return alert('Kode dan nama aset wajib diisi.'); if(cost<=0)return alert('Nilai perolehan harus lebih dari 0.'); if(res<0||res>cost)return alert('Nilai residu tidak valid.'); if(life<=0)return alert('Umur manfaat harus lebih dari 0.');
    if(!['SL','DB','UOP'].includes(astMethod.value))return alert('Metode penyusutan tidak valid.'); if(astMethod.value==='UOP'&&safeNum(astUnitsTotal.value)<=0)return alert('Unit produksi total wajib diisi untuk metode unit produksi.');
    if(db.assets.some(x=>x.code===code&&x.id!==id))return alert('Kode aset sudah digunakan.');
    const o={id:id||'AST-'+Date.now(),code,name,category:astCat.value,status:astStatus.value,acquisitionDate:astAcq.value,availableDate:astAvail.value,cost,residual:res,usefulYears:life,method:astMethod.value,unitsTotal:safeNum(astUnitsTotal.value),unitsUsed:safeNum(astUnitsUsed.value),assetAccount:astAssetAccount.value,accumAccount:astAccumAccount.value,expenseAccount:astExpenseAccount.value,sourceAccount:astSourceAccount.value,location:astLocation.value.trim(),responsible:astResponsible.value.trim(),notes:astNotes.value.trim()};
    if(o.availableDate<o.acquisitionDate)return alert('Tanggal tersedia tidak boleh sebelum tanggal perolehan.');
    if(id){const old=db.assets.find(x=>x.id===id); if(old){Object.assign(old,o);}}
    else db.assets.push(o);
    saveA();closeModal();renderAssets();renderAssetSummary();if(typeof renderAll==='function')renderAll();
    if(postAcq&&!id)try{postAssetAcquisition(o);}catch(e){alert('Master tersimpan, tetapi jurnal perolehan gagal: '+e.message)}
  };
  function postAssetAcquisition(a){
    const existing=(db.journals||[]).some(j=>j.meta&&j.meta.assetId===a.id&&j.meta.kind==='acquisition'); if(existing)return alert('Jurnal perolehan aset ini sudah ada.');
    const j=ABYAN_POST(a.acquisitionDate,'Perolehan aset tetap '+a.code+' - '+a.name,[{account:a.assetAccount,dc:'D',amount:a.cost},{account:a.sourceAccount,dc:'C',amount:a.cost}],{kind:'acquisition',assetId:a.id,assetCode:a.code});
    saveA(); renderAssets();renderAssetSummary();if(typeof renderAll==='function')renderAll(); alert('Perolehan aset dan jurnal otomatis berhasil dicatat.');
  }
  window.postAssetAcquisition=postAssetAcquisition;
  window.postAssetDepreciation=function(id){
    ensure();const a=db.assets.find(x=>x.id===id);if(!a)return;const p=db.settings.period,st=assetState(a),due=Math.max(0,st.plan-st.accumulated),already=postedDep(a,p);if(due<=0.005)return alert('Tidak ada penyusutan yang perlu diposting untuk aset ini pada periode tersebut.');
    if(already>0)return alert('Penyusutan periode '+p+' untuk aset ini sudah diposting sebesar '+money(already)+'.');
    const amt=Math.round(due*100)/100;ABYAN_POST(periodEnd(),'Penyusutan '+a.code+' - '+a.name,[{account:a.expenseAccount,dc:'D',amount:amt},{account:a.accumAccount,dc:'C',amount:amt}],{kind:'depreciation',assetId:a.id,assetCode:a.code,period:p});saveA();renderAssets();renderAssetSummary();if(typeof renderAll==='function')renderAll();alert('Penyusutan '+money(amt)+' berhasil diposting.');
  };
  window.postAllAssetDepreciation=function(){ensure();let n=0,total=0,errors=[];db.assets.filter(a=>a.status==='Aktif').forEach(a=>{const st=assetState(a),due=Math.max(0,st.plan-st.accumulated),already=postedDep(a,db.settings.period);if(due>0.005&&!already){try{ABYAN_POST(periodEnd(),'Penyusutan '+a.code+' - '+a.name,[{account:a.expenseAccount,dc:'D',amount:Math.round(due*100)/100},{account:a.accumAccount,dc:'C',amount:Math.round(due*100)/100}],{kind:'depreciation',assetId:a.id,assetCode:a.code,period:db.settings.period});n++;total+=due;}catch(e){errors.push(a.code+': '+e.message)}}});saveA();renderAssets();renderAssetSummary();if(typeof renderAll==='function')renderAll();alert('Posting selesai. '+n+' aset diposting, total '+money(total)+(errors.length?'\n\nGagal:\n'+errors.join('\n'):''));};
  window.deleteAsset=function(id){ensure();const a=db.assets.find(x=>x.id===id);if(!a)return;const has=(db.journals||[]).some(j=>j.meta&&j.meta.assetId===id);if(has)return alert('Aset sudah memiliki jurnal. Gunakan status Dilepas atau Fully Depreciated; jangan hapus agar histori audit tetap terjaga.');if(confirm('Hapus master aset '+a.code+'?')){db.assets=db.assets.filter(x=>x.id!==id);saveA();renderAssets();renderAssetSummary();}};
  function assetRows(){ensure();const q=(document.getElementById('assetSearch')?.value||'').toLowerCase(),st=document.getElementById('assetStatusFilter')?.value||'';return db.assets.filter(a=>(!q||(a.code+' '+a.name+' '+a.location+' '+a.responsible).toLowerCase().includes(q))&&(!st||a.status===st));}
  window.renderAssets=function(){ensure();const rows=assetRows();const el=document.getElementById('assetTable');if(!el)return;el.innerHTML=rows.length?`<div class="asset-table-wrap"><table class="table asset-table"><thead><tr><th>Kode</th><th>Aset</th><th>Kategori</th><th>Perolehan</th><th>Metode</th><th>Umur</th><th>Perolehan</th><th>Akum. Penyusutan</th><th>Nilai Buku</th><th>Progress</th><th>Status</th><th>Aksi</th></tr></thead><tbody>${rows.map(a=>{const s=assetState(a),depPct=a.cost?Math.min(100,s.accumulated/Math.max(a.cost-a.residual,1)*100):0;return `<tr><td><b>${escA(a.code)}</b><div class="asset-mini">${escA(a.location)}</div></td><td>${escA(a.name)}<div class="asset-mini">${escA(a.responsible)}</div></td><td>${escA(a.category)}</td><td>${escA(a.availableDate)}</td><td>${a.method==='SL'?'Garis Lurus':a.method==='DB'?'Saldo Menurun':'Unit Produksi'}</td><td>${a.usefulYears} th</td><td class="num">${money(a.cost)}</td><td class="num">${money(s.accumulated)}</td><td class="num"><b>${money(s.book)}</b></td><td><span class="asset-mini">${depPct.toFixed(1)}%</span><div class="asset-progress"><i style="width:${depPct}%"></i></div></td><td><span class="asset-badge ${a.status==='Aktif'?'good':a.status==='Dilepas'?'bad':''}">${escA(a.status)}</span></td><td><button class="btn" onclick="openAssetForm('${escA(a.id)}')">Edit</button> <button class="btn good" onclick="postAssetDepreciation('${escA(a.id)}')">Susut</button> <button class="btn" onclick="exportOneAsset('${escA(a.id)}')">Ekspor</button> <button class="btn danger" onclick="deleteAsset('${escA(a.id)}')">Hapus</button></td></tr>`}).join('')}</tbody></table></div>`:'<div class="empty-ranking">Belum ada aset. Klik Tambah Aset untuk membuat register.</div>';
    renderAssetSchedule(rows);
  };
  function renderAssetSchedule(rows){const el=document.getElementById('assetScheduleTable');if(!el)return;el.innerHTML=rows.length?`<div class="tablewrap"><table class="table"><thead><tr><th>Kode</th><th>Nama</th><th>Dasar Penyusutan</th><th>Umur</th><th>Metode</th><th>Akumulasi</th><th>Nilai Buku</th><th>Beban Periode</th><th>Status</th></tr></thead><tbody>${rows.map(a=>{const s=assetState(a),method=a.method==='SL'?'Garis Lurus':a.method==='DB'?'Saldo Menurun':'Unit Produksi';return `<tr><td>${escA(a.code)}</td><td>${escA(a.name)}</td><td>${money(Math.max(0,a.cost-a.residual))}</td><td>${a.usefulYears} tahun</td><td>${method}</td><td>${money(s.accumulated)}</td><td>${money(s.book)}</td><td>${money(Math.max(0,s.plan-s.accumulated))}</td><td>${s.book<=a.residual+0.005?'Fully Depreciated':'Aktif'}</td></tr>`}).join('')}</tbody></table></div>`:'<div class="empty-ranking">Jadwal belum tersedia.</div>';}
  window.renderAssetSummary=function(){ensure();const rows=db.assets,st=db.settings.period,totalCost=rows.reduce((s,a)=>s+a.cost,0),acc=rows.reduce((s,a)=>s+assetState(a).accumulated,0),book=rows.reduce((s,a)=>s+assetState(a).book,0),periodDep=rows.reduce((s,a)=>s+postedDep(a,st),0);['assetCostKpi','assetAccumKpi','assetBookKpi','assetPeriodDepKpi'].forEach((id,i)=>{const e=document.getElementById(id);if(e)e.textContent=money([totalCost,acc,book,periodDep][i]);});const sm=document.getElementById('assetDepSummary');if(sm)sm.innerHTML=`<div class="asset-summary-grid"><div><span>Aset Aktif</span><b>${rows.filter(a=>a.status==='Aktif').length}</b></div><div><span>Belum Posting Periode</span><b>${rows.filter(a=>a.status==='Aktif'&&Math.max(0,assetState(a).plan-assetState(a).accumulated)>0.005&&!postedDep(a,st)).length}</b></div><div><span>Nilai Buku</span><b>${money(book)}</b></div><div><span>Periode</span><b>${escA(st)}</b></div></div>`;}
  window.exportAssetsJSON=function(){ensure();const out=db.assets.map(a=>({...a,calculated:assetState(a)}));download('ASET-TETAP-detail-'+today()+'.json',JSON.stringify({version:1,standard:db.settings.standard,exportedAt:new Date().toISOString(),assets:out},null,2),'application/json');};
  window.exportAssetsCSV=function(){ensure();const rows=[['id','code','name','category','status','acquisitionDate','availableDate','cost','residual','usefulYears','method','unitsTotal','unitsUsed','assetAccount','accumAccount','expenseAccount','sourceAccount','location','responsible','notes'],...db.assets.map(a=>[a.id,a.code,a.name,a.category,a.status,a.acquisitionDate,a.availableDate,a.cost,a.residual,a.usefulYears,a.method,a.unitsTotal,a.unitsUsed,a.assetAccount,a.accumAccount,a.expenseAccount,a.sourceAccount,a.location,a.responsible,a.notes])];const cell=v=>'"'+String(v??'').replace(/"/g,'""')+'"';download('ASET-TETAP-bulk-'+today()+'.csv',rows.map(r=>r.map(cell).join(',')).join('\n'),'text/csv;charset=utf-8');};
  window.exportOneAsset=function(id){ensure();const a=db.assets.find(x=>x.id===id);if(!a)return;download('aset-'+a.code+'-'+today()+'.json',JSON.stringify({...a,calculated:assetState(a),journals:(db.journals||[]).filter(j=>j.meta&&j.meta.assetId===id)},null,2),'application/json');};
  function parseA(text){if(typeof parseCSV==='function')return parseCSV(text);return text.split(/\r?\n/).map(x=>x.split(','));}
  document.getElementById('assetImportFile').onchange=function(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const txt=r.result;if(f.name.toLowerCase().endsWith('.json')){const x=JSON.parse(txt);const arr=Array.isArray(x)?x:(x.assets||[]);arr.forEach(o=>{if(!o.code||!o.name)return;const old=db.assets.find(a=>a.code===String(o.code));const n={...o,id:old?.id||o.id||'AST-'+Date.now()+Math.random().toString(16).slice(2)};delete n.calculated;if(old)Object.assign(old,n);else db.assets.push(n);});}else{const rows=parseA(txt);if(!rows.length)throw new Error('CSV kosong');const h=rows[0].map(x=>String(x).trim());for(let i=1;i<rows.length;i++){const r=rows[i],o={};h.forEach((k,j)=>o[k]=r[j]??'');if(!o.code||!o.name)continue;o.cost=safeNum(o.cost);o.residual=safeNum(o.residual);o.usefulYears=safeNum(o.usefulYears)||5;o.unitsTotal=safeNum(o.unitsTotal);o.unitsUsed=safeNum(o.unitsUsed);o.status=o.status||'Aktif';o.method=o.method||'SL';const old=db.assets.find(a=>a.code===String(o.code));if(old)Object.assign(old,o);else db.assets.push({...o,id:o.id||'AST-'+Date.now()+Math.random().toString(16).slice(2)});}}saveA();renderAssets();renderAssetSummary();if(typeof renderAll==='function')renderAll();alert('Import aset berhasil.');}catch(err){alert('Import aset gagal: '+err.message)}e.target.value='';};r.readAsText(f);};
  // Add asset information to dashboard without changing existing KPIs.
  const oldDash=window.renderDashboard;window.renderDashboard=function(){try{oldDash&&oldDash();}catch(e){};ensure();renderAssetSummary();const host=document.getElementById('assetDashboardCard');if(host){const rows=db.assets.map(a=>({a,s:assetState(a)}));host.innerHTML=`<div class="card-head"><div><h3>Manajemen Aset</h3><p>Nilai aset tetap dan penyusutan periode ${escA(db.settings.period)}</p></div><button class="btn" onclick="showPage('assets')">Lihat Aset →</button></div><div class="asset-summary-grid"><div><span>Nilai Perolehan</span><b>${money(rows.reduce((s,x)=>s+x.a.cost,0))}</b></div><div><span>Akumulasi Penyusutan</span><b>${money(rows.reduce((s,x)=>s+x.s.accumulated,0))}</b></div><div><span>Nilai Buku</span><b>${money(rows.reduce((s,x)=>s+x.s.book,0))}</b></div><div><span>Aset Aktif</span><b>${rows.filter(x=>x.a.status==='Aktif').length}</b></div></div>`;}};
  function addDashCard(){const d=document.getElementById('dashboard');if(!d||document.getElementById('assetDashboardCard'))return;const c=document.createElement('div');c.className='card section';c.id='assetDashboardCard';const anchor=d.querySelector('.card.section:last-of-type')||d.lastElementChild;d.insertBefore(c,anchor||null);}
  const oldAll=window.renderAll;window.renderAll=function(){ensure();try{oldAll&&oldAll();}catch(e){};try{renderAssets();renderAssetSummary();addDashCard();window.renderDashboard&&window.renderDashboard();}catch(e){console.warn('Asset render:',e)}};
  const oldShow=window.showPage;window.showPage=function(p){const labels={dashboard:'Dashboard',evaluation:'Evaluasi & Rasio',journal:'Jurnal Umum',ledger:'Buku Besar',cash:'Kas & Bank',trial:'Neraca Saldo',income:'Laba Rugi',balance:'Neraca',cashflow:'Arus Kas',equity:'Perubahan Ekuitas',budget:'Anggaran vs Realisasi',assets:'Manajemen Aset',coa:'COA / Akun',settings:'Pengaturan',exports:'Export / Import Laporan'};document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));const pg=document.getElementById(p);if(pg)pg.classList.add('active');document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===p));const pt=document.getElementById('pageTitle');if(pt)pt.textContent=labels[p]||p;try{renderAll();}catch(e){console.error(e)}};
  ensure();
  setTimeout(()=>{try{renderAssets();renderAssetSummary();addDashCard();}catch(e){}},0);
})();

/* ===== EXPORT / IMPORT EXCEL & PDF CENTER ===== */
(function(){
  function xesc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function safe(v){return v==null?'':v;}
  function sheet(name, headers, rows){return {name:String(name).slice(0,31),headers,rows};}
  function reportSheets(){
    const out=[]; const [f,t]=periodBounds();
    const trial=[['Kode','Akun','Tipe','Debit','Kredit']];
    accounts().forEach(a=>{let v=sumAccount(a.code,f,t);trial.push([a.code,a.name,a.type,v>0?v:0,v<0?-v:0]);});
    out.push(sheet('Neraca Saldo',trial[0],trial.slice(1)));
    const rev=accounts().filter(a=>a.type==='Revenue').map(a=>[a.code,a.name,normalBalance(a,sumAccount(a.code,f,t))]);
    const exp=accounts().filter(a=>a.type==='Expense').map(a=>[a.code,a.name,normalBalance(a,sumAccount(a.code,f,t))]);
    out.push(sheet('Laba Rugi',['Kode','Akun','Nilai'],[...rev.map(x=>[...x,'Pendapatan']),...exp.map(x=>[...x,'Beban']),['','','Laba Bersih',rev.reduce((s,x)=>s+x[2],0)-exp.reduce((s,x)=>s+x[2],0)]]));
    const bs=['Aset','Liabilitas','Ekuitas']; const bsRows=[];
    bs.forEach(tp=>accounts().filter(a=>a.type===(tp==='Aset'?'Asset':tp==='Liabilitas'?'Liability':'Equity')).forEach(a=>bsRows.push([a.code,a.name,tp,normalBalance(a,sumAccount(a.code,f,t))])));
    out.push(sheet('Neraca',['Kode','Akun','Kelompok','Nilai'],bsRows));
    const cashCodes=accounts().filter(a=>a.code.startsWith('1101')||a.code.startsWith('1102')).map(a=>a.code); const cashRows=[];
    db.journals.forEach(j=>j.lines.forEach(l=>{if(cashCodes.includes(l.account))cashRows.push([j.date,j.no,j.desc,l.account,l.debit||0,l.credit||0]);}));
    out.push(sheet('Arus Kas',['Tanggal','No Bukti','Deskripsi','Akun','Debit','Kredit'],cashRows));
    const eqRows=accounts().filter(a=>a.type==='Equity').map(a=>[a.code,a.name,normalBalance(a,sumAccount(a.code,f,t))]);
    out.push(sheet('Perubahan Ekuitas',['Kode','Akun','Nilai'],eqRows));
    const jr=[]; db.journals.forEach(j=>j.lines.forEach(l=>jr.push([j.date,j.no,j.desc,l.account,l.debit||0,l.credit||0])));
    out.push(sheet('Jurnal',['Tanggal','No Bukti','Deskripsi','Kode Akun','Debit','Kredit'],jr));
    const led=[]; accounts().forEach(a=>{let bal=0;db.journals.slice().sort((x,y)=>x.date.localeCompare(y.date)).forEach(j=>j.lines.forEach(l=>{if(l.account===a.code){bal+=Number(l.debit||0)-Number(l.credit||0);led.push([a.code,a.name,j.date,j.no,j.desc,l.debit||0,l.credit||0,normalBalance(a,bal)]);}}));});
    out.push(sheet('Buku Besar',['Kode','Akun','Tanggal','No Bukti','Deskripsi','Debit','Kredit','Saldo'],led));
    out.push(sheet('Kas Bank',['Tanggal','No Bukti','Deskripsi','Kode Akun','Debit','Kredit'],cashRows));
    const bRows=(db.budgets||[]).map((b,i)=>[i+1,b.unit||b.devisi||b.division||'',b.activity||b.name||b.kegiatan||b.account||'',Number(b.amount||b.budget||0),Number(b.realization||b.realisasi||0),Number(b.amount||b.budget||0)-Number(b.realization||b.realisasi||0)]);
    out.push(sheet('Anggaran',['No','Devisi/Unit','Program/Kegiatan','Anggaran','Realisasi','Sisa'],bRows));
    const aRows=(db.assets||[]).map(a=>[a.code,a.name,a.category,a.acquisitionDate,a.availableDate,a.cost,a.residual,a.usefulYears,a.method,a.location,a.responsible,a.status]);
    out.push(sheet('Aset',['Kode','Nama','Kategori','Tanggal Perolehan','Tersedia','Nilai Perolehan','Nilai Residu','Umur Manfaat','Metode','Lokasi','Penanggung Jawab','Status'],aRows));
    out.push(sheet('COA',['Kode','Nama Akun','Kelompok','Tipe','Saldo Normal','Aktif','Posting'],db.coa.map(a=>[a.code,a.name,a.group||'',a.type,a.normal,a.active!==false,a.postable!==false])));
    return out;
  }
  function workbookHTML(sheets){
    let html='<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{font-family:Arial}table{border-collapse:collapse;margin:20px 0}th,td{border:1px solid #777;padding:6px 8px}th{background:#dbeafe;font-weight:bold}.sheet{page-break-after:always}h2{font-size:16px}</style></head><body>';
    sheets.forEach(sh=>{html+='<div class="sheet"><h2>'+xesc(sh.name)+'</h2><table><thead><tr>'+sh.headers.map(h=>'<th>'+xesc(h)+'</th>').join('')+'</tr></thead><tbody>'+sh.rows.map(r=>'<tr>'+r.map(v=>'<td>'+xesc(v)+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>';});
    return html+'</body></html>';
  }
  function downloadBlob(name,content,type){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([content],{type}));a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},1000);}
  window.exportAllReportsExcel=function(){const html=workbookHTML(reportSheets());downloadBlob('AL_BAYAN_HIDAYATULLAH_SEMUA_LAPORAN_'+today()+'.xls',html,'application/vnd.ms-excel;charset=utf-8');const e=document.getElementById('exportReportStatus');if(e)e.textContent='Export Excel berhasil: seluruh laporan + data master tersedia dalam satu workbook.';};
  window.exportCurrentReportExcel=function(id,name){const el=document.getElementById(id);if(!el)return alert('Laporan belum tersedia.');const table=el.querySelector('table');if(!table)return alert('Tabel laporan belum tersedia.');const html='<!DOCTYPE html><html><head><meta charset="utf-8"></head><body><h2>'+xesc(name)+'</h2>'+table.outerHTML+'</body></html>';downloadBlob('AL_BAYAN_'+name.replace(/\s+/g,'_')+'_'+today()+'.xls',html,'application/vnd.ms-excel;charset=utf-8');};
  function printHTML(title,body){const w=window.open('','_blank','width=1200,height=800');if(!w)return alert('Popup diblokir. Izinkan popup untuk export PDF.');w.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>'+xesc(title)+'</title><style>@page{size:A4 landscape;margin:12mm}body{font-family:Arial,sans-serif;color:#111;font-size:11px}h1{font-size:18px;margin:0 0 5px}h2{font-size:15px;margin:18px 0 6px}.sheet{page-break-after:always}.tablewrap{overflow:visible}table{width:100%;border-collapse:collapse;margin:8px 0}th,td{border:1px solid #999;padding:5px 6px;text-align:left}th{background:#eee}td.num,th.num{text-align:right}.num{text-align:right}.no-print{display:none!important}</style></head><body>'+body+'</body></html>');w.document.close();w.focus();setTimeout(()=>w.print(),400);}
  window.exportCurrentReportPDF=function(id,name){const el=document.getElementById(id);if(!el)return alert('Laporan belum tersedia.');printHTML(name,el.innerHTML);};
  window.exportAllReportsPDF=function(){const ss=reportSheets();let body='';ss.forEach(sh=>{body+='<div class="sheet"><h1>AL BAYAN HIDAYATULLAH MAKASSAR</h1><h2>'+xesc(sh.name)+'</h2><p>Periode: '+xesc(period())+'</p><table><thead><tr>'+sh.headers.map(h=>'<th>'+xesc(h)+'</th>').join('')+'</tr></thead><tbody>'+sh.rows.map(r=>'<tr>'+r.map(v=>'<td>'+xesc(v)+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>';});printHTML('AL BAYAN — Semua Laporan',body);};
  function parseHTMLWorkbook(txt){const doc=new DOMParser().parseFromString(txt,'text/html');return [...doc.querySelectorAll('table')].map(t=>{const rows=[...t.rows].map(tr=>[...tr.cells].map(c=>c.textContent.trim()));return rows;}).filter(r=>r.length);}
  function importSheet(rows){if(!rows.length)return;const h=rows[0].map(x=>x.toLowerCase().trim());const has=x=>h.includes(x);const val=(r,...keys)=>{for(const k of keys){const i=h.indexOf(k.toLowerCase());if(i>=0)return r[i];}return '';};
    if(has('kode')&&has('nama akun')&&has('tipe')){for(const r of rows.slice(1)){const code=val(r,'kode');const name=val(r,'nama akun');if(!code||!name)continue;let a=db.coa.find(x=>x.code===code);const o={code,name,group:val(r,'kelompok'),type:val(r,'tipe'),normal:val(r,'saldo normal')||'Debit',active:String(val(r,'aktif')).toLowerCase()!=='false',postable:String(val(r,'posting')).toLowerCase()!=='false'};if(a)Object.assign(a,o);else db.coa.push(o);}return 'COA';}
    if(has('devisi/unit')&&has('program/kegiatan')&&has('anggaran')){for(const r of rows.slice(1)){const activity=val(r,'program/kegiatan');if(!activity)continue;const code='BUD-'+Date.now()+'-'+Math.random().toString(16).slice(2);db.budgets.push({id:code,unit:val(r,'devisi/unit'),activity,amount:Number(String(val(r,'anggaran')).replace(/[^0-9.-]/g,''))||0,realization:Number(String(val(r,'realisasi')).replace(/[^0-9.-]/g,''))||0});}return 'Anggaran';}
    if(has('kode')&&has('nama')&&has('nilai perolehan')){for(const r of rows.slice(1)){const code=val(r,'kode');if(!code)continue;const old=db.assets.find(a=>a.code===code);const o={code,name:val(r,'nama'),category:val(r,'kategori'),acquisitionDate:val(r,'tanggal perolehan'),availableDate:val(r,'tersedia'),cost:Number(String(val(r,'nilai perolehan')).replace(/[^0-9.-]/g,''))||0,residual:Number(String(val(r,'nilai residu')).replace(/[^0-9.-]/g,''))||0,usefulYears:Number(val(r,'umur manfaat'))||5,method:val(r,'metode')||'SL',location:val(r,'lokasi'),responsible:val(r,'penanggung jawab'),status:val(r,'status')||'Aktif'};if(old)Object.assign(old,o);else db.assets.push({...o,id:'AST-'+Date.now()+Math.random().toString(16).slice(2)});}return 'Aset';}
    return '';
  }
  const fi=document.getElementById('excelImportFile'); if(fi)fi.addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const txt=r.result;let sheets=parseHTMLWorkbook(txt);if(!sheets.length&&typeof parseCSV==='function')sheets=[parseCSV(txt)];let done=[];sheets.forEach(rows=>{const x=importSheet(rows);if(x)done.push(x);});saveA&&saveA();if(typeof save==='function')save();renderAll&&renderAll();alert(done.length?'Import Excel selesai: '+[...new Set(done)].join(', '):'File Excel tidak berisi sheet data yang dikenali. Gunakan workbook hasil Export Semua Excel.');}catch(err){alert('Import Excel gagal: '+err.message)}f.value='';};r.readAsText(f);});
  const pfi=document.getElementById('pdfImportFile'); if(pfi)pfi.addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;try{const key='abyan_pdf_archive_v1';const arr=JSON.parse(localStorage.getItem(key)||'[]');arr.push({name:f.name,size:f.size,importedAt:new Date().toISOString()});localStorage.setItem(key,JSON.stringify(arr.slice(-50)));alert('PDF berhasil diarsipkan. PDF tidak mengubah jurnal/COA karena PDF bukan format data transaksi.');}catch(err){alert('Import PDF gagal: '+err.message)}e.target.value='';});
  const oldShowPage=window.showPage;window.showPage=function(p){oldShowPage&&oldShowPage(p);if(p==='exports'){const e=document.getElementById('exportReportStatus');if(e)e.textContent='Export Excel mencakup seluruh laporan dan data master. Import Excel dipakai untuk memulihkan COA, Anggaran, dan Aset. PDF adalah format laporan siap cetak, bukan format database.';}};
})();

</script>
</body></html>